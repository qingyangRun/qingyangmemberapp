<view class="app theme-{{theme}} st-{{state}}">
  <view class="main mp-page">
    <view class="seg">
      <view class="a {{period === 'day' ? 'on' : ''}}" hover-class="tap" bindtap="pickPeriod" data-period="day">
        <text>今日</text>
      </view>
      <view class="a {{period === 'week' ? 'on' : ''}}" hover-class="tap" bindtap="pickPeriod" data-period="week">
        <text>本周</text>
      </view>
      <view class="a {{period === 'month' ? 'on' : ''}}" hover-class="tap" bindtap="pickPeriod" data-period="month">
        <text>本月</text>
      </view>
    </view>

    <view class="range">
      <text class="span">{{rangeText}} · {{compareText}}</text>
      <text class="b">{{syncText}}</text>
    </view>

    <view class="stat-grid kpis">
      <view class="section stat">
        <text class="k">营业额</text>
        <view class="v num">
          <text class="span">¥{{revenueText}}</text>
        </view>
        <view class="d {{revenueDiff >= 0 ? 'up' : 'down'}}">
          <view class="{{revenueDiff >= 0 ? 'i-arrow-up' : 'i-arrow-down'}} ic"></view>
          <text class="span">{{revenueDiffText}}</text>
        </view>
      </view>
      <view class="section stat">
        <text class="k">会员充值</text>
        <view class="v num">
          <text class="span">¥{{rechargeText}}</text>
        </view>
        <view class="d {{rechargeDiff >= 0 ? 'up' : 'down'}}">
          <view class="{{rechargeDiff >= 0 ? 'i-arrow-up' : 'i-arrow-down'}} ic"></view>
          <text class="span">{{rechargeDiffText}}</text>
        </view>
      </view>
      <view class="section stat">
        <text class="k">次卡售出</text>
        <view class="v num">
          <text class="span">{{cardSold}}</text>
          <text class="small">张</text>
        </view>
        <view class="d {{cardSoldDiff >= 0 ? 'up' : 'down'}}">
          <view class="{{cardSoldDiff >= 0 ? 'i-arrow-up' : 'i-arrow-down'}} ic"></view>
          <text class="span">{{cardSoldDiffText}}</text>
        </view>
      </view>
      <view class="section stat">
        <text class="k">核销</text>
        <view class="v num">
          <text class="span">{{verifyCount}}</text>
          <text class="small">次</text>
        </view>
        <view class="d {{verifyDiff >= 0 ? 'up' : 'down'}}">
          <view class="{{verifyDiff >= 0 ? 'i-arrow-up' : 'i-arrow-down'}} ic"></view>
          <text class="span">{{verifyDiffText}}</text>
        </view>
      </view>
    </view>

    <view class="section card chart-card">
      <view class="chart-head">
        <text class="h2">营业额趋势</text>
        <text class="span">单位：元</text>
      </view>
      <view class="chart">
        <view class="b" wx:for="{{bars}}" wx:key="label">
          <view class="i {{item.hot ? 'on' : ''}}" style="height:{{item.height}}%"></view>
          <text class="span">{{item.label}}</text>
        </view>
      </view>
      <view class="between" style="margin-top:28rpx;padding-top:24rpx;border-top:2rpx solid var(--line)">
        <text class="span small muted">日均营业额</text>
        <view class="b num" style="font-size:var(--fs-15);font-weight:600">
          <text class="span">¥{{avgText}}</text>
        </view>
      </view>
    </view>

    <view class="section-head" style="padding:36rpx 8rpx 0">
      <text class="h2">会员维度</text>
    </view>
    <view class="dims">
      <view class="button dim" hover-class="tap" bindtap="openMemberFilter">
        <text>{{levelFilterText}}</text>
        <view class="i-chevron-down ic"></view>
      </view>
      <view class="button dim" hover-class="tap" bindtap="openMemberFilter">
        <text>{{statusFilterText}}</text>
        <view class="i-chevron-down ic"></view>
      </view>
      <view class="button dim" hover-class="tap" bindtap="openMemberFilter">
        <text>{{tagFilterText}}</text>
        <view class="i-chevron-down ic"></view>
      </view>
    </view>

    <view class="section card breakdown">
      <view class="breakdown-head">
        <text class="h2">消费构成</text>
        <text class="span">{{periodName}} · ¥{{revenueText}}</text>
      </view>
      <view class="stack">
        <view class="i a" style="width:{{balancePercent}}%"></view>
        <view class="i b" style="width:{{cardPercent}}%"></view>
      </view>
      <view class="legend">
        <view>
          <view class="k">
            <view class="i"></view>
            <text>余额消费</text>
          </view>
          <view class="b">
            <view class="span">
              <text>¥{{balanceRevenueText}}</text>
              <text class="small">{{balancePercent}}%</text>
            </view>
          </view>
        </view>
        <view>
          <view class="k">
            <view class="i teal"></view>
            <text>次卡核销</text>
          </view>
          <view class="b">
            <view class="span">
              <text>¥{{cardRevenueText}}</text>
              <text class="small">{{cardPercent}}%</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="section-head" style="padding:36rpx 8rpx 20rpx">
      <text class="h2">会员贡献 Top 3</text>
      <view class="a more" bindtap="go" data-page="members" hover-class="tap">
        <text>全部会员</text>
        <view class="i-chevron ic"></view>
      </view>
    </view>

    <view class="card list" wx:if="{{topMembers.length}}">
      <view class="cell top-cell" wx:for="{{topMembers}}" wx:key="id" bindtap="openMember" data-id="{{item.id}}" hover-class="tap">
        <text class="span rank {{item.isTop ? 'top' : ''}}">{{item.rank}}</text>
        <text class="span ava sm {{item.avaClass}}">{{item.initial}}</text>
        <view class="cell-main">
          <view class="cell-title">
            <text>{{item.name}}</text>
            <text class="span badge {{item.levelBadge}}">{{item.levelName}}</text>
          </view>
          <text class="cell-sub">{{item.visitText}} · 累计消费 ¥{{item.consumeText}}</text>
          <view class="bar-track">
            <view class="i {{item.rank === 1 ? 'gold' : ''}}" style="width:{{item.percent}}%"></view>
          </view>
        </view>
        <text class="span cell-amt">¥{{item.amountText}}</text>
      </view>
    </view>

    <view class="card empty" wx:else>
      <text>这段时间还没有消费数据</text>
    </view>

    <text class="p page-lead" style="margin-top:28rpx">{{footNote}}</text>
  </view>
</view>
