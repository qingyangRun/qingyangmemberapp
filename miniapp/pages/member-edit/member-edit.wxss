/* 编辑会员 */
.who .cell-main{min-width:0}.who .status{display:inline-flex;align-items:center;gap:8rpx;font-size:var(--fs-12);color:var(--success);flex:none}.tag-pick{display:flex;flex-wrap:wrap;gap:16rpx;padding:8rpx 32rpx 24rpx}.tag-pick .tag{height:88rpx;padding:0 24rpx;font-size:var(--fs-12);border-radius:18rpx}.tag-pick .add{display:inline-flex;align-items:center;gap:6rpx;height:88rpx;padding:0 22rpx;border-radius:18rpx;border:2rpx dashed var(--line-strong);color:var(--muted);font-size:var(--fs-12);background:#fff}.tag-pick .add .ic{width:26rpx;height:26rpx;stroke-width:2.2}.rule-row{display:flex;align-items:center;gap:16rpx;padding:26rpx 32rpx;border-top:2rpx solid var(--line)}.rule-row .cell-main{flex:1;min-width:0}.rule-row .cell-title{font-size:var(--fs-15)}.rule-row .cell-sub{margin-top:2rpx}.rule-row .lk{display:inline-flex;align-items:center;gap:2rpx;min-height:88rpx;margin:-20rpx 0;font-size:var(--fs-12);color:var(--primary);flex:none}.rule-row .lk .ic{width:28rpx;height:28rpx;stroke-width:2}.cards-mini{padding:8rpx 32rpx 24rpx}.cards-mini .cm{display:flex;align-items:center;gap:20rpx;padding:20rpx 0;border-bottom:2rpx solid var(--line)}.cards-mini .cm:last-child{border-bottom:0;padding-bottom:4rpx}.cards-mini .cm .cell-main{min-width:0}.cards-mini .nm{font-size:var(--fs-15);font-weight:500}.cards-mini .sub{font-size:var(--fs-11);color:var(--muted);margin-top:2rpx}.danger-zone{margin-top:40rpx;display:flex;justify-content:center}.danger-zone .button{display:inline-flex;align-items:center;gap:10rpx;height:88rpx;padding:0 28rpx;font-size:var(--fs-13);color:var(--danger)}.danger-zone .ic{width:32rpx;height:32rpx}.field-note .b{color:var(--ink-2);font-weight:600}
