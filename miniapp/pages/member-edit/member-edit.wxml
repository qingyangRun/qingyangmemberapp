<view class="app theme-{{theme}} st-{{state}}">
  <view class="main mp-page has-action">

    <view class="card who" style="margin-bottom:24rpx" wx:if="{{member}}">
      <text class="span ava {{member.avaClass}}">{{member.initial}}</text>
      <view class="cell-main">
        <view class="nm">
          <text>{{member.name}}</text>
          <text class="span badge {{member.levelBadge}}">{{member.levelName}}</text>
        </view>
        <text class="sub">卡号 {{member.cardNo}} · {{member.joinedText}} 入会</text>
      </view>
      <view class="span status">
        <view class="span dot {{status === 'normal' ? '' : status === 'sleeping' ? 'warn' : 'gray'}}"></view>
        <text>{{status === 'normal' ? '正常' : status === 'sleeping' ? '沉睡' : '停用'}}</text>
      </view>
    </view>

    <view class="section form-group">
      <view class="group-head">
        <text class="h2">基本信息</text>
      </view>
      <view class="field">
        <text class="label lb">姓名</text>
        <view class="ctl">
          <input class="input" data-key="f0" value="{{inputs.f0}}" placeholder="会员姓名" bindinput="onInput" />
        </view>
      </view>
      <view class="field">
        <text class="label lb">手机号</text>
        <view class="ctl">
          <input class="input" type="number" maxlength="11" data-key="f1" value="{{inputs.f1}}" placeholder="11 位手机号" bindinput="onInput" />
        </view>
      </view>
      <view class="field">
        <text class="span lb">性别</text>
        <view class="ctl">
          <view class="seg mini">
            <view class="button {{gender === 'male' ? 'on' : ''}}" hover-class="tap" bindtap="pickGender" data-gender="male">
              <text>男</text>
            </view>
            <view class="button {{gender === 'female' ? 'on' : ''}}" hover-class="tap" bindtap="pickGender" data-gender="female">
              <text>女</text>
            </view>
            <view class="button {{gender === '' ? 'on' : ''}}" hover-class="tap" bindtap="pickGender" data-gender="">
              <text>保密</text>
            </view>
          </view>
        </view>
      </view>
      <view class="button field" style="text-align:left" hover-class="tap">
        <text class="span lb">生日</text>
        <picker mode="date" value="{{birthday || '1995-01-01'}}" start="1930-01-01" end="2026-12-31" bindchange="onBirthday">
          <view class="span ctl">
            <text class="span val {{birthday ? '' : 'placeholder'}}">{{birthday || '选填'}}</text>
            <view class="i-calendar ic tail"></view>
          </view>
        </picker>
      </view>
    </view>

    <view class="section form-group">
      <view class="group-head">
        <text class="h2">会员标记</text>
        <text class="span">可多选</text>
      </view>
      <view class="tag-pick">
        <view class="button tag {{item.on ? 'on' : ''}}" hover-class="tap" bindtap="toggleTag" data-tag="{{item.name}}" wx:for="{{tags}}" wx:key="name">
          <text>{{item.name}}</text>
        </view>
      </view>
      <text class="p field-note">标记会显示在会员卡和列表里，并可用于筛选、批量发送优惠。</text>
    </view>

    <view class="section form-group">
      <view class="group-head">
        <text class="h2">会员状态</text>
      </view>
      <view class="field">
        <text class="span lb">当前状态</text>
        <view class="ctl">
          <view class="seg mini">
            <view class="button {{status === 'normal' ? 'on' : ''}}" hover-class="tap" bindtap="pickStatus" data-status="normal">
              <text>正常</text>
            </view>
            <view class="button {{status === 'sleeping' ? 'on' : ''}}" hover-class="tap" bindtap="pickStatus" data-status="sleeping">
              <text>沉睡</text>
            </view>
            <view class="button {{status === 'disabled' ? 'on' : ''}}" hover-class="tap" bindtap="pickStatus" data-status="disabled">
              <text>停用</text>
            </view>
          </view>
        </view>
      </view>
      <text class="p field-note">停用后无法充值、核销，会员仍保留全部记录，可随时恢复。</text>
    </view>

    <view class="section form-group">
      <view class="group-head">
        <text class="h2">等级</text>
        <text class="span">自动评定</text>
      </view>
      <view class="rule-row">
        <view class="span lead gold">
          <view class="i-crown ic"></view>
        </view>
        <view class="cell-main">
          <text class="cell-title">当前等级：{{levelName}}</text>
          <text class="cell-sub">累计充值 ¥{{rechargeText}} · 累计消费 ¥{{consumeText}}</text>
        </view>
        <view class="a lk" bindtap="goLevels" hover-class="tap">
          <text>等级规则</text>
          <view class="i-chevron ic"></view>
        </view>
      </view>
    </view>

    <view class="section form-group">
      <view class="group-head">
        <text class="h2">次卡</text>
        <view class="a more small" style="color:var(--primary)" bindtap="goBuyCard" hover-class="tap">
          <text>为该会员开卡</text>
        </view>
      </view>
      <view class="cards-mini" wx:if="{{cards.length}}">
        <view class="cm" wx:for="{{cards}}" wx:key="id">
          <view class="span ava sm teal">
            <view class="i-cards ic" style="width:34rpx;height:34rpx"></view>
          </view>
          <view class="cell-main">
            <text class="nm">{{item.name}}</text>
            <text class="sub">剩 {{item.left}} / {{item.total}} 次 · {{item.expireText}}</text>
          </view>
          <text class="span badge teal">{{item.left}} 次</text>
        </view>
      </view>
      <view class="empty" wx:else>
        <text>还没有次卡</text>
      </view>
    </view>

    <view class="section form-group">
      <view class="group-head">
        <text class="h2">备注</text>
        <text class="span">仅店内可见</text>
      </view>
      <view class="field-col">
        <textarea class="area" data-key="f2" value="{{inputs.f2}}" placeholder="记录偏好、忌口、过敏史等" bindinput="onInput" maxlength="200" />
      </view>
    </view>

    <view class="danger-zone">
      <view class="button" hover-class="tap" bindtap="removeMember">
        <view class="i-trash ic"></view>
        <text>停用该会员</text>
      </view>
    </view>
  </view>

  <view class="mp-actionbar split">
    <view class="a btn btn-ghost" style="flex:1" bindtap="go" data-page="member-detail" hover-class="tap">
      <text>取消</text>
    </view>
    <view class="a btn btn-primary" style="flex:2" bindtap="save" hover-class="tap">
      <text>保存修改</text>
    </view>
  </view>
</view>
