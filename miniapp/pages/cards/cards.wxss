/* 次卡项目 */
.tcard{padding:28rpx 32rpx}.tcard+.tcard{margin-top:20rpx}.tcard-top{display:flex;align-items:center;gap:24rpx}.tem{width:88rpx;height:88rpx;border-radius:26rpx;display:grid;place-items:center;background:var(--accent-soft);color:var(--accent);flex:none}.tem .ic{width:42rpx;height:42rpx}.tcard .nm{display:flex;align-items:center;gap:12rpx;font-size:var(--fs-15);font-weight:600}.tcard .sub{margin-top:4rpx;font-size:var(--fs-11);color:var(--muted);font-variant-numeric:tabular-nums}.tcard .price{flex:none;text-align:right}.tcard .price .b{display:block;font-size:var(--fs-18);font-weight:600;font-variant-numeric:tabular-nums;letter-spacing:-.01em}.tcard .price .span{display:block;font-size:var(--fs-11);color:var(--muted)}.tcard-foot{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-top:24rpx;padding-top:20rpx;border-top:2rpx solid var(--line);font-size:var(--fs-11);color:var(--muted);font-variant-numeric:tabular-nums}.tcard-foot .lk{display:inline-flex;align-items:center;justify-content:center;gap:4rpx;min-width:104rpx;height:88rpx;margin:-24rpx 0;padding:0 8rpx;color:var(--ink-2);font-size:var(--fs-12);flex:none}.tcard-foot .lk .ic{width:26rpx;height:26rpx;stroke-width:2;color:var(--faint)}.tcard.off .nm{color:var(--muted)}.st-edit .mask{display:flex}.st-edit .mp-actionbar{display:none}
