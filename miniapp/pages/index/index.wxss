/* 清样会员 */
.hero{position:relative;overflow:hidden;background:#101B2E;border-radius:var(--r-xl);padding:36rpx;color:#fff;box-shadow:var(--shadow-md)}.hero::after{content:"";position:absolute;right:-92rpx;top:-156rpx;width:392rpx;height:392rpx;border-radius:50%;background:radial-gradient(circle,var(--primary-glow),transparent 68%)}.hero-top{position:relative;z-index:1;display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx}.hero-lb{font-size:var(--fs-12);color:#AEBBD0;letter-spacing:.04em}.hero-num{display:flex;align-items:baseline;margin-top:6rpx;font-size:var(--fs-36);font-weight:600;line-height:1.08;letter-spacing:-.025em;font-variant-numeric:tabular-nums}.hero-num .cny{font-size:var(--fs-18);font-weight:500;color:#D6DEF0;margin-right:4rpx}.hero-num .dec{font-size:var(--fs-18);color:#C9D3E6}.hero-tag{display:inline-flex;align-items:center;gap:4rpx;height:46rpx;padding:0 16rpx;border-radius:14rpx;background:rgba(20,163,159,.2);color:#69E4D7;font-size:var(--fs-11);font-weight:600;flex:none}.hero-tag .ic{width:22rpx;height:22rpx;stroke-width:2.4}.hero-sub{margin-top:10rpx;font-size:var(--fs-12);color:#93A3BC}.hero-stats{position:relative;z-index:1;display:flex;margin-top:30rpx;padding-top:26rpx;border-top:2rpx solid rgba(255,255,255,.13)}.hero-stats>div{flex:1;display:flex;flex-direction:column;gap:6rpx;min-width:0}.hero-stats>div+div{padding-left:28rpx;border-left:2rpx solid rgba(255,255,255,.1)}.hero-stats .span{font-size:var(--fs-11);color:#9FAEC6}.hero-stats .b{font-size:var(--fs-16);font-weight:600;color:#fff;font-variant-numeric:tabular-nums;white-space:nowrap}.hero-stats .b .i{font-style:normal;font-size:var(--fs-11);font-weight:400;color:#9FAEC6;margin-left:2rpx}.quick{display:grid;grid-template-columns:repeat(4,1fr);margin-top:24rpx;padding:18rpx 8rpx}.quick .a{display:flex;flex-direction:column;align-items:center;gap:14rpx;padding:18rpx 4rpx;border-radius:24rpx;font-size:var(--fs-12);color:var(--ink-2);min-height:160rpx;justify-content:center}.quick .qi{width:88rpx;height:88rpx;border-radius:28rpx;display:grid;place-items:center;background:var(--primary-soft);color:var(--primary)}.quick .qi .ic{width:44rpx;height:44rpx}.quick .qi.teal{background:var(--accent-soft);color:var(--accent)}.quick .qi.gold{background:var(--gold-soft);color:var(--gold)}.quick .qi.dark{background:var(--ink);color:#fff}.task .cell{padding-top:24rpx;padding-bottom:24rpx}.task .cell-title{font-size:var(--fs-15);font-weight:500}.task .cell-sub{margin-top:2rpx}.feed .cell{padding-top:22rpx;padding-bottom:22rpx}.feed .cell-title{font-weight:400;flex-wrap:wrap;row-gap:4rpx}.feed .cell-title .b{font-weight:600;white-space:nowrap;flex:none}.feed .cell-amt{font-size:var(--fs-15)}.feed .cell-amt .u{font-size:var(--fs-11);font-weight:400;color:var(--muted);margin-left:4rpx}.foot-note{display:flex;align-items:center;justify-content:center;gap:10rpx;margin-top:44rpx;font-size:var(--fs-11);color:var(--muted)}
