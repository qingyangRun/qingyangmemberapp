<view class="app theme-{{theme}} st-{{state}}">
  <view class="main mp-page">
    <view class="section hero">
      <view class="hero-top">
        <view>
          <text class="p hero-lb">今日实收</text>
          <view class="p hero-num">
            <text class="span cny">¥</text>
            <text>{{revenueInt}}</text>
            <text class="span dec">.{{revenueDec}}</text>
          </view>
          <text class="p hero-sub">{{dateText}} · 数据更新至 {{updatedText}}</text>
        </view>
        <view class="span hero-tag {{syncMode === 'cloud' ? '' : 'local'}}">
          <view class="{{syncMode === 'cloud' ? 'i-refresh' : 'i-phone'}} ic"></view>
          <text>{{syncText}}</text>
        </view>
      </view>
      <view class="hero-stats">
        <view>
          <text class="span">会员充值</text>
          <text class="b">¥{{rechargeText}}</text>
        </view>
        <view>
          <text class="span">核销</text>
          <view class="b">
            <text>{{verifyCount}}</text>
            <text class="i">笔</text>
          </view>
        </view>
        <view>
          <text class="span">新增会员</text>
          <view class="b">
            <text>{{newMembers}}</text>
            <text class="i">人</text>
          </view>
        </view>
      </view>
    </view>

    <view class="nav card quick">
      <view class="a" bindtap="go" data-page="member-new" hover-class="tap">
        <view class="span qi">
          <view class="i-user-plus ic"></view>
        </view>
        <text>创建会员</text>
      </view>
      <view class="a" bindtap="go" data-page="recharge" hover-class="tap">
        <view class="span qi teal">
          <view class="i-wallet ic"></view>
        </view>
        <text>会员充值</text>
      </view>
      <view class="a" bindtap="go" data-page="verify" hover-class="tap">
        <view class="span qi dark">
          <view class="i-scan ic"></view>
        </view>
        <text>核销</text>
      </view>
      <view class="a" bindtap="go" data-page="recharge" data-state="card" hover-class="tap">
        <view class="span qi gold">
          <view class="i-cards ic"></view>
        </view>
        <text>次卡开卡</text>
      </view>
    </view>

    <view class="section section">
      <view class="section-head">
        <text class="h2">待处理</text>
        <view class="a more" bindtap="go" data-page="members" data-state="filter" hover-class="tap">
          <text>全部</text>
          <view class="i-chevron ic"></view>
        </view>
      </view>
      <view class="card list task">
        <view class="a cell" bindtap="go" data-page="members" data-state="filter" hover-class="tap">
          <view class="span lead gold">
            <view class="i-cake ic"></view>
          </view>
          <view class="span cell-main">
            <text class="span cell-title">今天生日</text>
            <text class="span cell-sub">{{birthday}} 位会员 · 可发送生日券</text>
          </view>
          <text class="span pill {{birthday ? '' : 'gray'}}">{{birthday}}</text>
          <view class="i-chevron ic chev"></view>
        </view>
        <view class="a cell" bindtap="go" data-page="members" data-state="filter" hover-class="tap">
          <view class="span lead warn">
            <view class="i-clock ic"></view>
          </view>
          <view class="span cell-main">
            <text class="span cell-title">沉睡会员</text>
            <text class="span cell-sub">{{sleeping}} 人超过 30 天未到店</text>
          </view>
          <text class="span pill warn">{{sleeping}}</text>
          <view class="i-chevron ic chev"></view>
        </view>
        <view class="a cell" bindtap="go" data-page="members" hover-class="tap">
          <view class="span lead teal">
            <view class="i-cards ic"></view>
          </view>
          <view class="span cell-main">
            <text class="span cell-title">次卡将到期</text>
            <text class="span cell-sub">{{expiring}} 张 · 30 天内到期</text>
          </view>
          <text class="span pill gray">{{expiring}}</text>
          <view class="i-chevron ic chev"></view>
        </view>
      </view>
    </view>

    <view class="section section">
      <view class="section-head">
        <text class="h2">最近动态</text>
        <view class="a more" bindtap="go" data-page="records" hover-class="tap">
          <text>流水</text>
          <view class="i-chevron ic"></view>
        </view>
      </view>

      <view class="card list feed" wx:if="{{feed.length}}">
        <view class="a cell" wx:for="{{feed}}" wx:key="id" bindtap="openRecord" data-id="{{item.id}}" hover-class="tap">
          <text class="span ava sm {{item.avaClass}}">{{item.initial}}</text>
          <view class="span cell-main">
            <view class="span cell-title">
              <text class="b">{{item.memberName}}</text>
              <text>{{item.actionText}}</text>
            </view>
            <text class="span cell-sub">{{item.subText}}</text>
          </view>
          <text class="span cell-amt {{item.amountCls}}">{{item.amountText}}</text>
        </view>
      </view>

      <view class="card empty" wx:else>
        <text>还没有流水，去核销或充值试试</text>
      </view>
    </view>

    <view class="p foot-note" bindtap="onSyncTap">
      <view class="i-refresh ic" style="width:24rpx;height:24rpx"></view>
      <text>{{syncFootText}}</text>
    </view>
  </view>
</view>
