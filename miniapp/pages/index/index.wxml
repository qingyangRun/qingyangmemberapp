<view class="app theme-{{theme}} st-{{state}}">
  <view class="main mp-page">
    <view class="section hero">
      <view class="div hero-top">
        <view class="div">
          <text class="p hero-lb">今日实收</text>
          <view class="p hero-num">
            <text class="span cny">¥</text>
            <text>3,286</text>
            <text class="span dec">.50</text>
          </view>
          <text class="p hero-sub">11 月 25 日 周三 · 数据更新至 10:32</text>
        </view>
        <view class="span hero-tag">
          <view class="i-arrow-up ic"></view>
          <text>较昨日 12.4%</text>
        </view>
      </view>
      <view class="div hero-stats">
        <view class="div">
          <text class="span">会员充值</text>
          <text class="b">¥1,200</text>
        </view>
        <view class="div">
          <text class="span">核销</text>
          <view class="b">
            <text>27</text>
            <text class="i">笔</text>
          </view>
        </view>
        <view class="div">
          <text class="span">新增会员</text>
          <view class="b">
            <text>6</text>
            <text class="i">人</text>
          </view>
        </view>
      </view>
    </view>
    <view class="nav card quick">
      <view class="a" bindtap="go" data-page="member-new" hover-class="tap">
        <view class="span qi">
          <view class="i-user-plus ic"></view>
        </view>
        <text>创建会员</text>
      </view>
      <view class="a" bindtap="go" data-page="recharge" hover-class="tap">
        <view class="span qi teal">
          <view class="i-wallet ic"></view>
        </view>
        <text>会员充值</text>
      </view>
      <view class="a" bindtap="go" data-page="verify" hover-class="tap">
        <view class="span qi dark">
          <view class="i-scan ic"></view>
        </view>
        <text>核销</text>
      </view>
      <view class="a" bindtap="go" data-page="recharge" data-state="card" hover-class="tap">
        <view class="span qi gold">
          <view class="i-cards ic"></view>
        </view>
        <text>次卡开卡</text>
      </view>
    </view>
    <view class="section section">
      <view class="div section-head">
        <text class="h2">待处理</text>
        <view class="a more" bindtap="go" data-page="members" hover-class="tap">
          <text>全部</text>
          <view class="i-chevron ic"></view>
        </view>
      </view>
      <view class="div card list task">
        <view class="a cell" bindtap="go" data-page="members" hover-class="tap">
          <view class="span lead gold">
            <view class="i-cake ic"></view>
          </view>
          <view class="span cell-main">
            <text class="span cell-title">今天生日</text>
            <text class="span cell-sub">3 位会员 · 可发送生日券</text>
          </view>
          <text class="span pill">3</text>
          <view class="i-chevron ic chev"></view>
        </view>
        <view class="a cell" bindtap="go" data-page="members" data-state="filter" hover-class="tap">
          <view class="span lead warn">
            <view class="i-clock ic"></view>
          </view>
          <view class="span cell-main">
            <text class="span cell-title">沉睡会员</text>
            <text class="span cell-sub">12 人超过 30 天未到店</text>
          </view>
          <text class="span pill warn">12</text>
          <view class="i-chevron ic chev"></view>
        </view>
        <view class="a cell" bindtap="go" data-page="members" hover-class="tap">
          <view class="span lead teal">
            <view class="i-cards ic"></view>
          </view>
          <view class="span cell-main">
            <text class="span cell-title">次卡将到期</text>
            <text class="span cell-sub">5 张 · 30 天内到期</text>
          </view>
          <text class="span pill gray">5</text>
          <view class="i-chevron ic chev"></view>
        </view>
      </view>
    </view>
    <view class="section section">
      <view class="div section-head">
        <text class="h2">最近动态</text>
        <view class="a more" bindtap="go" data-page="records" hover-class="tap">
          <text>流水</text>
          <view class="i-chevron ic"></view>
        </view>
      </view>
      <view class="div card list feed">
        <view class="a cell" bindtap="go" data-page="member-detail" hover-class="tap">
          <text class="span ava sm gold">陈</text>
          <view class="span cell-main">
            <view class="span cell-title">
              <text class="b">陈嘉怡</text>
              <text>充值 ¥500</text>
            </view>
            <text class="span cell-sub">10:24 · 余额充值 · 赠 ¥50</text>
          </view>
          <text class="span cell-amt in">+¥550.00</text>
        </view>
        <view class="a cell" bindtap="go" data-page="records" data-state="cardverify" hover-class="tap">
          <text class="span ava sm teal">林</text>
          <view class="span cell-main">
            <view class="span cell-title">
              <text class="b">林之遥</text>
              <text>核销剪发次卡</text>
            </view>
            <text class="span cell-sub">10:12 · 次卡核销 · 剩 8 次</text>
          </view>
          <view class="span cell-amt">
            <text>−1</text>
            <text class="span u">次</text>
          </view>
        </view>
        <view class="a cell" bindtap="go" data-page="member-detail" hover-class="tap">
          <text class="span ava sm gray">周</text>
          <view class="span cell-main">
            <view class="span cell-title">
              <text class="b">周明轩</text>
              <text>购买头皮护理卡</text>
            </view>
            <text class="span cell-sub">09:58 · 次卡购买 · 6 次</text>
          </view>
          <text class="span cell-amt in">+¥1,080.00</text>
        </view>
        <view class="a cell" bindtap="go" data-page="member-detail" hover-class="tap">
          <text class="span ava sm">沈</text>
          <view class="span cell-main">
            <view class="span cell-title">
              <text class="b">沈知夏</text>
              <text>新会员建档</text>
            </view>
            <text class="span cell-sub">09:41 · 由 林岚 创建</text>
          </view>
          <view class="span cell-amt">
            <text class="span badge blue">新会员</text>
          </view>
        </view>
      </view>
    </view>
    <view class="p foot-note">
      <view class="i-refresh ic" style="width:24rpx;height:24rpx"></view>
      <text>数据每 5 分钟同步一次</text>
    </view>
  </view>
</view>
