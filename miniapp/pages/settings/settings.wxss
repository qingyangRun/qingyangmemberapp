/* 管理 */
.shop{overflow:hidden}.shop-top{display:flex;align-items:center;gap:24rpx;padding:32rpx}.shop .mark{width:104rpx;height:104rpx;border-radius:30rpx;display:grid;place-items:center;background:var(--ink);color:#fff;font-size:var(--fs-20);font-weight:600;flex:none;letter-spacing:.02em}.shop .nm{display:flex;align-items:center;gap:12rpx;font-size:var(--fs-16);font-weight:600;line-height:1.3}.shop .sub{margin-top:4rpx;font-size:var(--fs-11);color:var(--muted);line-height:1.5}.shop .edit{flex:none;height:88rpx;padding:0 28rpx;border-radius:20rpx;background:var(--surface-2);border:2rpx solid var(--line);font-size:var(--fs-12);color:var(--ink-2)}.shop-stats{display:flex;border-top:2rpx solid var(--line);background:var(--surface-2)}.shop-stats>div{flex:1;min-width:0;padding:20rpx 32rpx}.shop-stats>div+div{border-left:2rpx solid var(--line)}.shop-stats .span{display:block;font-size:var(--fs-11);color:var(--muted)}.shop-stats .b{display:block;margin-top:2rpx;font-size:var(--fs-16);font-weight:600;font-variant-numeric:tabular-nums}.shop-stats .b .small{font-size:var(--fs-11);font-weight:400;color:var(--muted);margin-left:2rpx}.g-label{padding:36rpx 8rpx 16rpx;font-size:var(--fs-12);font-weight:600;color:var(--muted)}.set .cell{padding:24rpx 32rpx}.set .cell-title{font-size:var(--fs-15);font-weight:500}.set .cell-sub{margin-top:2rpx;font-size:var(--fs-11)}.set .lead{width:68rpx;height:68rpx;border-radius:20rpx}.set .lead .ic{width:36rpx;height:36rpx}.set .cell-amt{font-size:var(--fs-11);color:var(--muted);font-weight:400}.footer{margin-top:48rpx;text-align:center;font-size:var(--fs-11);color:var(--muted);line-height:1.7}
