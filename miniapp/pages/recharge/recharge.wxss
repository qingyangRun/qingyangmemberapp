/* 储值开卡 */
.who .fig{flex:none;text-align:right}.who .fig .span{display:block;font-size:var(--fs-11);color:var(--muted)}.who .fig .b{font-size:var(--fs-15);font-weight:600;font-variant-numeric:tabular-nums}.amt-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16rpx}.amt-grid .button{height:92rpx;border-radius:22rpx;border:2rpx solid var(--line);background:var(--surface);font-size:var(--fs-15);font-weight:600;color:var(--ink-2);font-variant-numeric:tabular-nums}.amt-grid .button.on{border-color:var(--primary);background:var(--primary-soft);color:var(--primary)}.giftline{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-top:20rpx;padding:18rpx 24rpx;border-radius:20rpx;background:var(--gold-soft)}.giftline .span{display:inline-flex;align-items:center;gap:10rpx;font-size:var(--fs-12);color:var(--gold)}.giftline .span .ic{width:28rpx;height:28rpx;stroke-width:2}.giftline .b{font-size:var(--fs-13);color:var(--gold);font-variant-numeric:tabular-nums}.arrive{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-top:20rpx;font-size:var(--fs-13);color:var(--muted)}.arrive .b{font-size:var(--fs-18);font-weight:600;color:var(--ink);font-variant-numeric:tabular-nums}.pick .cell{padding:26rpx 32rpx;text-align:left;align-items:flex-start}.pick .nm{display:flex;align-items:center;gap:12rpx;font-size:var(--fs-15);font-weight:500}.pick .sub{margin-top:4rpx;font-size:var(--fs-12);color:var(--muted);font-variant-numeric:tabular-nums}.pick .pr{flex:none;text-align:right;margin-top:4rpx}.pick .pr .b{display:block;font-size:var(--fs-15);font-weight:600;font-variant-numeric:tabular-nums}.pick .pr .span{display:block;font-size:var(--fs-11);color:var(--muted)}.pick .cell.on{background:#FAFBFF}.pay .cell{text-align:left}.pay .cell-title{font-size:var(--fs-15)}.pay .cell-sub{margin-top:2rpx}.radio{width:40rpx;height:40rpx;border-radius:50%;border:3rpx solid var(--line-strong);flex:none;display:grid;place-items:center}.radio .i{width:20rpx;height:20rpx;border-radius:50%;background:var(--primary);opacity:0}.radio.on{border-color:var(--primary)}.radio.on .i{opacity:1}.fields{background:var(--surface);border:2rpx solid var(--line);border-radius:var(--r-lg);margin-top:24rpx}.fields .field{padding-left:32rpx;padding-right:32rpx}.fields .field .input{text-align:left}.st-default .card-only{display:none}.st-card .recharge-only{display:none}.st-default .sum-card{display:none}.st-default .seg .s-recharge, .st-card .seg .s-card{background:#fff;color:var(--ink);font-weight:600;box-shadow:var(--shadow-sm)}.notice{display:flex;align-items:flex-start;gap:12rpx;margin-top:24rpx;font-size:var(--fs-11);color:var(--muted);line-height:1.6}.notice .ic{width:26rpx;height:26rpx;margin-top:4rpx;flex:none;color:var(--faint);stroke-width:2}
