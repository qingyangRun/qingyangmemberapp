<view class="app theme-{{theme}} st-{{state}}">
  <view class="main mp-page has-action">
    <view class="div card who">
      <text class="span ava gold">陈</text>
      <view class="div cell-main">
        <view class="div nm">
          <text>陈嘉怡</text>
          <text class="span badge gold">金卡</text>
        </view>
        <text class="div sub">138 **** 6621 · QH 8821</text>
      </view>
      <view class="div fig">
        <text class="span">当前余额</text>
        <text class="b">¥1,280.00</text>
      </view>
    </view>
    <view class="div seg" style="margin-top:24rpx">
      <view class="a s-recharge" hover-class="tap" bindtap="setState" data-state="default">
        <text>余额充值</text>
      </view>
      <view class="a s-card" hover-class="tap" bindtap="setState" data-state="card">
        <text>购买次卡</text>
      </view>
    </view>
    <view class="div recharge-only">
      <view class="section card vsec" style="margin-top:24rpx">
        <view class="div vsec-head">
          <text class="h2">充值金额</text>
          <text class="span">充 500 赠 50</text>
        </view>
        <view class="div amt-grid">
          <view class="button" hover-class="tap">
            <text>¥200</text>
          </view>
          <view class="button on" hover-class="tap">
            <text>¥500</text>
          </view>
          <view class="button" hover-class="tap">
            <text>¥1,000</text>
          </view>
          <view class="button" hover-class="tap">
            <text>¥2,000</text>
          </view>
        </view>
        <view class="div amount lg">
          <text class="span cur">¥</text>
          <input class="input" data-key="f0" value="{{inputs.f0}}" placeholder="" bindinput="onInput" />
        </view>
        <view class="div giftline">
          <view class="span">
            <view class="i-gift ic"></view>
            <text>满 ¥500 赠 ¥50</text>
          </view>
          <text class="b">+50.00</text>
        </view>
        <view class="div arrive">
          <text class="span">本次到账（含赠送）</text>
          <text class="b">¥550.00</text>
        </view>
      </view>
      <view class="section card vsec" style="margin-top:24rpx">
        <view class="div vsec-head">
          <text class="h2">升级进度</text>
          <text class="span">黑金卡</text>
        </view>
        <view class="div between" style="font-size:var(--fs-12);color:var(--muted)">
          <text class="span">累计消费 ¥6,420 / ¥8,000</text>
          <text class="span">差 ¥1,580</text>
        </view>
        <view class="div bar-track" style="margin-top:16rpx">
          <view class="i gold" style="width:80%"></view>
        </view>
        <text class="p vsec-head" style="margin:16rpx 0 0;display:block;font-size:var(--fs-11);color:var(--muted)">本次充值计 500 积分，赠送金额不计积分。</text>
      </view>
    </view>
    <view class="div card-only">
      <view class="div card list pick" style="margin-top:24rpx">
        <view class="button cell on" hover-class="tap">
          <view class="span ck on">
            <view class="i-check ic"></view>
          </view>
          <view class="span cell-main">
            <view class="span nm">
              <text>剪发次卡</text>
              <text class="span badge teal">10 + 2 次</text>
            </view>
            <text class="span sub">有效期 12 个月 · 单价 ¥56.7 / 次</text>
          </view>
          <view class="span pr">
            <text class="b">¥680</text>
            <text class="span">省 ¥136</text>
          </view>
        </view>
        <view class="button cell" hover-class="tap">
          <view class="span ck">
            <view class="i-check ic"></view>
          </view>
          <view class="span cell-main">
            <view class="span nm">
              <text>头皮护理</text>
              <text class="span badge teal">6 + 1 次</text>
            </view>
            <text class="span sub">有效期 12 个月 · 单价 ¥154.3 / 次</text>
          </view>
          <view class="span pr">
            <text class="b">¥1,080</text>
            <text class="span">省 ¥96</text>
          </view>
        </view>
        <view class="button cell" hover-class="tap">
          <view class="span ck">
            <view class="i-check ic"></view>
          </view>
          <view class="span cell-main">
            <view class="span nm">
              <text>染发次卡</text>
              <text class="span badge teal">3 次</text>
            </view>
            <text class="span sub">有效期 12 个月 · 单价 ¥560 / 次</text>
          </view>
          <view class="span pr">
            <text class="b">¥1,680</text>
            <text class="span">省 ¥84</text>
          </view>
        </view>
      </view>
      <view class="section card vsec" style="margin-top:24rpx">
        <view class="div vsec-head">
          <text class="h2">本次开卡</text>
          <text class="span">1 张</text>
        </view>
        <view class="div arrive" style="margin-top:0">
          <text class="span">剪发次卡到账</text>
          <text class="b">12 次</text>
        </view>
        <view class="div arrive">
          <text class="span">计入累计消费</text>
          <text class="b">¥680.00</text>
        </view>
        <view class="div arrive">
          <text class="span">预计获得积分</text>
          <text class="b">340</text>
        </view>
      </view>
    </view>
    <view class="section card list pay" style="margin-top:24rpx">
      <view class="button cell" hover-class="tap">
        <view class="span lead" style="background:var(--success-soft);color:var(--success)">
          <view class="i-wallet ic"></view>
        </view>
        <view class="span cell-main">
          <text class="span cell-title">微信支付</text>
          <text class="span cell-sub">实时到账，可原路退款</text>
        </view>
        <view class="span radio on">
          <view class="i"></view>
        </view>
      </view>
      <view class="button cell" hover-class="tap">
        <view class="span lead gold">
          <view class="i-banknote ic"></view>
        </view>
        <view class="span cell-main">
          <text class="span cell-title">现金</text>
          <text class="span cell-sub">前台收取，需当班对账</text>
        </view>
        <view class="span radio">
          <view class="i"></view>
        </view>
      </view>
      <view class="button cell" hover-class="tap">
        <view class="span lead">
          <view class="i-bankcard ic"></view>
        </view>
        <view class="span cell-main">
          <text class="span cell-title">银行卡</text>
          <text class="span cell-sub">POS 刷卡后手动确认</text>
        </view>
        <view class="span radio">
          <view class="i"></view>
        </view>
      </view>
    </view>
    <view class="div fields">
      <view class="div field">
        <text class="span lb">备注</text>
        <view class="div ctl">
          <input class="input" data-key="f1" value="{{inputs.f1}}" placeholder="选填，如「双十一活动」" bindinput="onInput" />
        </view>
      </view>
    </view>
    <view class="p notice">
      <view class="i-help ic"></view>
      <text>收款后立即生成记录，可在「记录」中查看；赠送金额不可提现、不可退。</text>
    </view>
  </view>
  <view class="div mp-actionbar recharge-only">
    <view class="div sum">
      <text class="span">实收金额</text>
      <text class="b">¥500.00</text>
    </view>
    <view class="a btn btn-primary" bindtap="go" data-page="member-detail" hover-class="tap">
      <text>确认收款</text>
    </view>
  </view>
  <view class="div mp-actionbar card-only">
    <view class="div sum">
      <text class="span">实收金额</text>
      <text class="b">¥680.00</text>
    </view>
    <view class="a btn btn-primary" bindtap="go" data-page="member-detail" hover-class="tap">
      <text>确认购买</text>
    </view>
  </view>
</view>
