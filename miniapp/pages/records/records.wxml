<view class="app theme-{{theme}} st-{{state}}">
  <view class="main mp-page">
    <view class="monthbar">
      <view class="button mnav" hover-class="tap" bindtap="prevMonth">
        <view class="i-back ic"></view>
      </view>
      <view class="mcur">
        <text class="b">{{monthText}}</text>
        <text class="span">{{rangeText}} · {{memberText}}</text>
      </view>
      <view class="button mnav" hover-class="tap" bindtap="nextMonth">
        <view class="i-chevron ic"></view>
      </view>
    </view>

    <view class="section card sum3">
      <view>
        <text class="span">收款合计</text>
        <text class="b">¥{{sumIncomeText}}</text>
      </view>
      <view>
        <text class="span">核销合计</text>
        <text class="b">¥{{sumConsumeText}}</text>
      </view>
      <view>
        <text class="span">流水笔数</text>
        <view class="b">
          <text>{{sumCount}}</text>
          <text class="small">笔</text>
        </view>
      </view>
    </view>

    <view class="chips">
      <view class="a chip c-all {{type === '' ? 'on' : ''}}" hover-class="tap" bindtap="pickType" data-type="">
        <text>全部</text>
      </view>
      <view class="a chip c-recharge {{type === 'recharge' ? 'on' : ''}}" hover-class="tap" bindtap="pickType" data-type="recharge">
        <text>余额充值</text>
      </view>
      <view class="a chip c-consume {{type === 'consume' ? 'on' : ''}}" hover-class="tap" bindtap="pickType" data-type="consume">
        <text>消费核销</text>
      </view>
      <view class="a chip c-cardbuy {{type === 'cardbuy' ? 'on' : ''}}" hover-class="tap" bindtap="pickType" data-type="cardbuy">
        <text>次卡购买</text>
      </view>
      <view class="a chip c-cardverify {{type === 'cardverify' ? 'on' : ''}}" hover-class="tap" bindtap="pickType" data-type="cardverify">
        <text>次卡核销</text>
      </view>
    </view>

    <view class="list-head">
      <text class="h2">流水明细</text>
      <text class="span">按时间倒序</text>
    </view>

    <view class="card list" wx:if="{{list.length}}">
      <view class="cell rec" wx:for="{{list}}" wx:key="id" bindtap="openMember" data-member="{{item.memberId}}" hover-class="tap">
        <view class="span rec-ic {{item.cls}}">
          <view class="{{item.ic}} ic"></view>
        </view>
        <view class="span cell-main">
          <text class="span cell-title">{{item.title}}</text>
          <text class="span cell-sub">{{item.subText}}</text>
        </view>
        <text class="span cell-amt {{item.amountCls}}">{{item.amountText}}</text>
      </view>
    </view>

    <view class="card empty" wx:else>
      <text>本月还没有流水记录</text>
    </view>

    <view class="p end-note" wx:if="{{list.length}}">
      <view class="i-receipt ic" style="width:24rpx;height:24rpx"></view>
      <text>已展示 {{list.length}} 笔，本月共 {{sumCount}} 笔</text>
    </view>
  </view>
</view>
