/* 记录 */
.monthbar{display:flex;align-items:center;gap:16rpx;padding:16rpx 16rpx 20rpx}.mnav{width:88rpx;height:88rpx;border-radius:24rpx;display:grid;place-items:center;background:var(--surface);border:2rpx solid var(--line);color:var(--ink-2);flex:none}.mnav .ic{width:36rpx;height:36rpx;stroke-width:2}.mcur{flex:1;text-align:center;min-width:0}.mcur .b{font-size:var(--fs-15);font-weight:600}.mcur .span{display:block;margin-top:2rpx;font-size:var(--fs-11);color:var(--muted);font-variant-numeric:tabular-nums}.chips{margin-top:24rpx}.st-default .c-all, .st-recharge .c-recharge, .st-consume .c-consume, .st-cardbuy .c-cardbuy, .st-cardverify .c-cardverify{background:var(--ink);border-color:var(--ink);color:#fff;font-weight:500}.rec-ic{width:68rpx;height:68rpx;border-radius:20rpx;display:grid;place-items:center;flex:none;background:var(--primary-soft);color:var(--primary)}.rec-ic .ic{width:34rpx;height:34rpx;stroke-width:1.9}.rec-ic.consum{background:var(--surface-3);color:var(--ink-2)}.rec-ic.buy{background:var(--gold-soft);color:var(--gold)}.rec-ic.verify{background:var(--accent-soft);color:var(--accent)}.rec .cell-main{padding-top:2rpx}.st-recharge .rec:not(.t-recharge), .st-consume .rec:not(.t-consume), .st-cardbuy .rec:not(.t-cardbuy), .st-cardverify .rec:not(.t-cardverify){display:none}.end-note{display:flex;align-items:center;justify-content:center;gap:8rpx;padding:36rpx 0 0;font-size:var(--fs-11);color:var(--muted)}
