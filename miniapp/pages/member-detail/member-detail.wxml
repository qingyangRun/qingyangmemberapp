<view class="app theme-{{theme}} st-{{state}}">
  <view class="main mp-page">
    <view class="section mcard">
      <view class="div mcard-top">
        <text class="span ava lg gold">陈</text>
        <view class="div mcard-id">
          <view class="div mcard-name">
            <text>陈嘉怡</text>
            <text class="span badge gold">金卡</text>
          </view>
          <text class="p mcard-meta">138 **** 6621 · 卡号 QH 8821 · 2026-03-12 入会</text>
        </view>
        <view class="a mcard-edit" bindtap="go" data-page="member-edit" hover-class="tap">
          <view class="i-edit ic"></view>
        </view>
      </view>
      <view class="div mcard-tags">
        <text class="span">高复购</text>
        <text class="span">生日月</text>
        <text class="span">敏感头皮</text>
        <text class="span">正常</text>
      </view>
      <view class="div mcard-assets">
        <view class="div">
          <text class="span">账户余额</text>
          <view class="b">
            <text>¥1,280</text>
            <text class="small">.00</text>
          </view>
        </view>
        <view class="div">
          <text class="span">次卡可用</text>
          <view class="b">
            <text>10</text>
            <text class="small">次 · 3 张卡</text>
          </view>
        </view>
      </view>
      <view class="div mcard-progress">
        <view class="div between">
          <text class="span">金卡 → 黑金卡</text>
          <view class="span">
            <text>累计消费</text>
            <text class="b">¥6,420</text>
            <text>/ ¥8,000</text>
          </view>
        </view>
        <view class="div track">
          <view class="i" style="width:80%"></view>
        </view>
      </view>
    </view>
    <view class="nav card actions">
      <view class="a" bindtap="go" data-page="recharge" hover-class="tap">
        <view class="span ai teal">
          <view class="i-wallet ic"></view>
        </view>
        <text>充值</text>
      </view>
      <view class="a" bindtap="go" data-page="verify" hover-class="tap">
        <view class="span ai dark">
          <view class="i-scan ic"></view>
        </view>
        <text>核销</text>
      </view>
      <view class="a" bindtap="go" data-page="recharge" data-state="card" hover-class="tap">
        <view class="span ai gold">
          <view class="i-cards ic"></view>
        </view>
        <text>开次卡</text>
      </view>
      <view class="a" bindtap="go" data-page="member-edit" hover-class="tap">
        <view class="span ai">
          <view class="i-tag ic"></view>
        </view>
        <text>标记</text>
      </view>
    </view>
    <view class="section section">
      <view class="div section-head">
        <text class="h2">次卡</text>
        <view class="a more" bindtap="go" data-page="recharge" data-state="card" hover-class="tap">
          <text>＋ 开次卡</text>
        </view>
      </view>
      <view class="div card list">
        <view class="div cell cardrow">
          <view class="span lead teal">
            <view class="i-cards ic"></view>
          </view>
          <view class="div cell-main">
            <view class="div cell-title">
              <text>剪发次卡</text>
              <text class="span badge teal">8 / 12 次</text>
            </view>
            <text class="div cell-sub">有效期至 2027-03-31</text>
          </view>
          <view class="a btn btn-sm btn-soft" bindtap="go" data-page="verify" hover-class="tap">
            <text>核销</text>
          </view>
        </view>
        <view class="div cell cardrow">
          <view class="span lead teal">
            <view class="i-cards ic"></view>
          </view>
          <view class="div cell-main">
            <view class="div cell-title">
              <text>头皮护理</text>
              <text class="span badge teal">2 / 6 次</text>
            </view>
            <text class="div cell-sub">有效期至 2026-12-20</text>
          </view>
          <view class="a btn btn-sm btn-soft" bindtap="go" data-page="verify" hover-class="tap">
            <text>核销</text>
          </view>
        </view>
        <view class="div cell cardrow gone">
          <view class="span lead gray">
            <view class="i-cards ic"></view>
          </view>
          <view class="div cell-main">
            <view class="div cell-title">
              <text>染发次卡</text>
              <text class="span badge gray">已用完</text>
            </view>
            <text class="div cell-sub">有效期至 2026-10-01</text>
          </view>
          <text class="span badge gray">0 / 3 次</text>
        </view>
      </view>
    </view>
    <view class="section section">
      <view class="div section-head">
        <text class="h2">记录</text>
        <view class="a more" bindtap="go" data-page="records" hover-class="tap">
          <text>全部</text>
          <view class="i-chevron ic"></view>
        </view>
      </view>
      <view class="div card flush">
        <view class="nav rec-tabs">
          <view class="a t-consume" hover-class="tap" bindtap="setState" data-state="default">
            <text>消费核销</text>
          </view>
          <view class="a t-recharge" hover-class="tap" bindtap="setState" data-state="recharge">
            <text>余额充值</text>
          </view>
          <view class="a t-cardbuy" hover-class="tap" bindtap="setState" data-state="cardbuy">
            <text>次卡购买</text>
          </view>
          <view class="a t-cardverify" hover-class="tap" bindtap="setState" data-state="cardverify">
            <text>次卡核销</text>
          </view>
        </view>
        <view class="div list">
          <view class="div cell rec t-consume">
            <view class="span rec-time">
              <text class="b">11-24</text>
              <text class="span">16:20</text>
            </view>
            <view class="span cell-main">
              <text class="span cell-title">余额消费 · 剪发造型</text>
              <text class="span cell-sub">经办 林岚 · 余额支付</text>
            </view>
            <text class="span cell-amt">−¥168.00</text>
          </view>
          <view class="div cell rec t-consume">
            <view class="span rec-time">
              <text class="b">11-12</text>
              <text class="span">14:05</text>
            </view>
            <view class="span cell-main">
              <text class="span cell-title">余额消费 · 头皮护理</text>
              <text class="span cell-sub">经办 林岚 · 余额支付</text>
            </view>
            <text class="span cell-amt">−¥228.00</text>
          </view>
          <view class="div cell rec t-consume">
            <view class="span rec-time">
              <text class="b">10-03</text>
              <text class="span">11:26</text>
            </view>
            <view class="span cell-main">
              <text class="span cell-title">余额消费 · 洗剪吹</text>
              <text class="span cell-sub">经办 周宁 · 余额支付</text>
            </view>
            <text class="span cell-amt">−¥98.00</text>
          </view>
          <view class="div cell rec t-recharge">
            <view class="span rec-time">
              <text class="b">11-24</text>
              <text class="span">15:02</text>
            </view>
            <view class="span cell-main">
              <text class="span cell-title">余额充值 · 微信支付</text>
              <text class="span cell-sub">经办 林岚 · 赠 ¥50</text>
            </view>
            <text class="span cell-amt in">+¥550.00</text>
          </view>
          <view class="div cell rec t-recharge">
            <view class="span rec-time">
              <text class="b">10-20</text>
              <text class="span">12:40</text>
            </view>
            <view class="span cell-main">
              <text class="span cell-title">余额充值 · 现金</text>
              <text class="span cell-sub">经办 林岚 · 赠 ¥100</text>
            </view>
            <text class="span cell-amt in">+¥1,100.00</text>
          </view>
          <view class="div cell rec t-cardbuy">
            <view class="span rec-time">
              <text class="b">09-12</text>
              <text class="span">18:30</text>
            </view>
            <view class="span cell-main">
              <text class="span cell-title">次卡购买 · 剪发次卡</text>
              <text class="span cell-sub">10 次 + 赠 2 次 · 微信支付</text>
            </view>
            <text class="span cell-amt in">+¥680.00</text>
          </view>
          <view class="div cell rec t-cardbuy">
            <view class="span rec-time">
              <text class="b">06-08</text>
              <text class="span">13:15</text>
            </view>
            <view class="span cell-main">
              <text class="span cell-title">次卡购买 · 染发次卡</text>
              <text class="span cell-sub">3 次 · 银行卡</text>
            </view>
            <text class="span cell-amt in">+¥1,680.00</text>
          </view>
          <view class="div cell rec t-cardverify">
            <view class="span rec-time">
              <text class="b">11-25</text>
              <text class="span">10:12</text>
            </view>
            <view class="span cell-main">
              <text class="span cell-title">次卡核销 · 剪发次卡</text>
              <text class="span cell-sub">经办 林岚 · 剩余 8 次</text>
            </view>
            <view class="span cell-amt">
              <text>−1</text>
              <text class="span u">次</text>
            </view>
          </view>
          <view class="div cell rec t-cardverify">
            <view class="span rec-time">
              <text class="b">11-18</text>
              <text class="span">16:40</text>
            </view>
            <view class="span cell-main">
              <text class="span cell-title">次卡核销 · 头皮护理</text>
              <text class="span cell-sub">经办 周宁 · 剩余 2 次</text>
            </view>
            <view class="span cell-amt">
              <text>−1</text>
              <text class="span u">次</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
