<view class="app theme-{{theme}} st-{{state}}">
  <view class="main mp-page">
    <view class="section mcard" wx:if="{{member}}">
      <view class="mcard-top">
        <text class="span ava lg {{member.avaClass}}">{{member.initial}}</text>
        <view class="mcard-id">
          <view class="mcard-name">
            <text>{{member.name}}</text>
            <text class="span badge {{member.levelBadge}}">{{member.levelName}}</text>
          </view>
          <text class="p mcard-meta">{{member.phoneMasked}} · 卡号 {{member.cardNo}} · {{member.joinedText}} 入会</text>
        </view>
        <view class="a mcard-edit" bindtap="openEdit" hover-class="tap">
          <view class="i-edit ic"></view>
        </view>
      </view>

      <view class="mcard-tags">
        <text class="span" wx:for="{{member.tags}}" wx:key="*this">{{item}}</text>
        <text class="span">{{member.statusText}}</text>
      </view>

      <view class="mcard-assets">
        <view>
          <text class="span">账户余额</text>
          <view class="b">
            <text>¥{{member.balanceInt}}</text>
            <text class="small">.{{member.balanceDec}}</text>
          </view>
        </view>
        <view>
          <text class="span">次卡可用</text>
          <view class="b">
            <text>{{cardLeftTotal}}</text>
            <text class="small">次 · {{cardCount}} 张卡</text>
          </view>
        </view>
      </view>

      <view class="mcard-progress" wx:if="{{progress}}">
        <view class="between">
          <text class="span">{{member.levelName}} → {{progress.nextName}}</text>
          <view class="span">
            <text>累计消费</text>
            <text class="b">¥{{progress.currentText}}</text>
            <text>/ ¥{{progress.targetText}}</text>
          </view>
        </view>
        <view class="track">
          <view class="i" style="width:{{progress.percent}}%"></view>
        </view>
      </view>
    </view>

    <view class="nav card actions" wx:if="{{member}}">
      <view class="a" bindtap="goRecharge" hover-class="tap">
        <view class="span ai teal">
          <view class="i-wallet ic"></view>
        </view>
        <text>充值</text>
      </view>
      <view class="a" bindtap="goVerify" hover-class="tap">
        <view class="span ai dark">
          <view class="i-scan ic"></view>
        </view>
        <text>核销</text>
      </view>
      <view class="a" bindtap="goBuyCard" hover-class="tap">
        <view class="span ai gold">
          <view class="i-cards ic"></view>
        </view>
        <text>开次卡</text>
      </view>
      <view class="a" bindtap="openEdit" hover-class="tap">
        <view class="span ai">
          <view class="i-tag ic"></view>
        </view>
        <text>标记</text>
      </view>
    </view>

    <view class="section section" wx:if="{{cards.length}}">
      <view class="section-head">
        <text class="h2">次卡</text>
        <view class="a more" bindtap="goBuyCard" hover-class="tap">
          <text>＋ 开次卡</text>
        </view>
      </view>
      <view class="card list">
        <view class="cell cardrow {{item.isUsedUp ? 'gone' : ''}}" wx:for="{{cards}}" wx:key="id">
          <view class="span lead {{item.isUsedUp ? 'gray' : 'teal'}}">
            <view class="i-cards ic"></view>
          </view>
          <view class="cell-main">
            <view class="cell-title">
              <text>{{item.name}}</text>
              <text class="span badge {{item.isUsedUp ? 'gray' : 'teal'}}">{{item.leftText}}</text>
            </view>
            <text class="cell-sub">{{item.expireText}}</text>
          </view>
          <view class="a btn btn-sm btn-soft" wx:if="{{!item.isUsedUp}}" bindtap="verifyCard" data-id="{{item.id}}" hover-class="tap">
            <text>核销</text>
          </view>
          <text class="span badge gray" wx:else>{{item.used}} / {{item.total}} 次</text>
        </view>
      </view>
    </view>

    <view class="section section" wx:if="{{member}}">
      <view class="section-head">
        <text class="h2">记录</text>
        <view class="a more" bindtap="goRecords" hover-class="tap">
          <text>全部</text>
          <view class="i-chevron ic"></view>
        </view>
      </view>
      <view class="card flush">
        <view class="nav rec-tabs">
          <view class="a {{recType === 'consume' ? 'on' : ''}}" hover-class="tap" bindtap="pickRecType" data-type="consume">
            <text>消费核销</text>
          </view>
          <view class="a {{recType === 'recharge' ? 'on' : ''}}" hover-class="tap" bindtap="pickRecType" data-type="recharge">
            <text>余额充值</text>
          </view>
          <view class="a {{recType === 'cardbuy' ? 'on' : ''}}" hover-class="tap" bindtap="pickRecType" data-type="cardbuy">
            <text>次卡购买</text>
          </view>
          <view class="a {{recType === 'cardverify' ? 'on' : ''}}" hover-class="tap" bindtap="pickRecType" data-type="cardverify">
            <text>次卡核销</text>
          </view>
        </view>
        <view class="list" wx:if="{{recList.length}}">
          <view class="cell rec" wx:for="{{recList}}" wx:key="id">
            <view class="span rec-time">
              <text class="b">{{item.dateText}}</text>
              <text class="span">{{item.clockText}}</text>
            </view>
            <view class="span cell-main">
              <text class="span cell-title">{{item.typeName}}{{item.detailText}}</text>
              <text class="span cell-sub">{{item.remark}}</text>
            </view>
            <text class="span cell-amt {{item.amountCls}}">{{item.amountText}}</text>
          </view>
        </view>
        <view class="empty" wx:else>
          <text>暂无记录</text>
        </view>
      </view>
    </view>

    <view class="card empty" wx:if="{{!member}}">
      <text>会员不存在或已删除</text>
    </view>
  </view>
</view>
