/* 会员详情 */
.mcard{position:relative;overflow:hidden;background:#101B2E;border-radius:var(--r-xl);padding:36rpx;color:#fff;box-shadow:var(--shadow-md)}.mcard::after{content:"";position:absolute;right:-112rpx;top:-168rpx;width:400rpx;height:400rpx;border-radius:50%;background:radial-gradient(circle,var(--primary-glow),transparent 68%)}.mcard-top{position:relative;z-index:1;display:flex;align-items:flex-start;gap:24rpx}.mcard .ava{background:rgba(255,255,255,.12);color:#fff;border:2rpx solid rgba(255,255,255,.18)}.mcard-id{flex:1;min-width:0}.mcard-name{display:flex;align-items:center;gap:14rpx;font-size:var(--fs-18);font-weight:600;line-height:1.3}.mcard-meta{margin-top:6rpx;font-size:var(--fs-12);color:#A9B6CA;font-variant-numeric:tabular-nums}.mcard-edit{width:88rpx;height:88rpx;border-radius:22rpx;background:rgba(255,255,255,.1);display:grid;place-items:center;color:#DCE4F2;flex:none;margin:-10rpx -10rpx 0 0}.mcard-edit .ic{width:34rpx;height:34rpx}.mcard-tags{position:relative;z-index:1;display:flex;flex-wrap:wrap;gap:12rpx;margin-top:24rpx}.mcard-tags .span{display:inline-flex;align-items:center;height:44rpx;padding:0 16rpx;border-radius:12rpx;background:rgba(255,255,255,.08);font-size:var(--fs-11);color:#C6D2E4}.mcard-assets{position:relative;z-index:1;display:flex;margin-top:30rpx;padding-top:28rpx;border-top:2rpx solid rgba(255,255,255,.12)}.mcard-assets>div{flex:1;min-width:0}.mcard-assets .span{display:block;font-size:var(--fs-11);color:#97A6BE}.mcard-assets .b{display:block;margin-top:4rpx;font-size:var(--fs-20);font-weight:600;letter-spacing:-.02em;font-variant-numeric:tabular-nums;line-height:1.2}.mcard-assets .b .small{font-size:var(--fs-12);font-weight:400;color:#9FAEC6;margin-left:4rpx}.mcard-progress{position:relative;z-index:1;margin-top:28rpx}.mcard-progress .between{font-size:var(--fs-11);color:#97A6BE}.mcard-progress .between .b{color:#E7BC6B;font-weight:600}.mcard-progress .track{height:10rpx;border-radius:6rpx;background:rgba(255,255,255,.14);margin-top:12rpx;overflow:hidden}.mcard-progress .track .i{display:block;height:100%;border-radius:6rpx;background:linear-gradient(90deg,#C08A2E,#E7BC6B)}.actions{display:grid;grid-template-columns:repeat(4,1fr);margin-top:24rpx;padding:20rpx 8rpx}.actions .a{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12rpx;padding:14rpx 4rpx;min-height:152rpx;border-radius:24rpx;font-size:var(--fs-12);color:var(--ink-2)}.actions .ai{width:80rpx;height:80rpx;border-radius:26rpx;display:grid;place-items:center;background:var(--primary-soft);color:var(--primary)}.actions .ai .ic{width:40rpx;height:40rpx}.actions .ai.teal{background:var(--accent-soft);color:var(--accent)}.actions .ai.gold{background:var(--gold-soft);color:var(--gold)}.actions .ai.dark{background:var(--ink);color:#fff}.cardrow{padding:26rpx 32rpx}.cardrow .cell-title{font-size:var(--fs-15)}.cardrow .cell-sub{margin-top:4rpx}.card-status{display:flex;align-items:center;gap:16rpx}.gone .cell-title,.gone .cell-sub{color:var(--muted)}.rec-tabs{display:flex;gap:40rpx;overflow-x:auto;scrollbar-width:none;padding:0 32rpx;border-bottom:2rpx solid var(--line)}.rec-tabs .a{position:relative;display:flex;align-items:center;min-height:92rpx;font-size:var(--fs-13);color:var(--muted);white-space:nowrap}.rec-tabs .a.on{color:var(--ink);font-weight:600}.rec-tabs .a.on::after{content:"";position:absolute;left:0;right:0;bottom:0;height:4rpx;border-radius:4rpx;background:var(--primary)}