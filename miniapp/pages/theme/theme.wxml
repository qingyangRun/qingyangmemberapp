<view class="app theme-{{theme}} st-{{state}}">
  <view class="main mp-page">
    <view class="section card intro">
      <view class="p">
        <text>主题颜色决定</text>
        <text class="b">按钮、选中态、进度条和强调文字</text>
        <text>的颜色。选好后</text>
        <text class="b">{{syncHint}}</text>
        <text>，已保存的记录不受影响。</text>
      </view>
    </view>

    <view class="theme-list">
      <view class="button theme-opt {{theme === item.id ? 'on' : ''}}" bindtap="pickTheme" data-theme-option="{{item.id}}" hover-class="tap" wx:for="{{themes}}" wx:key="id">
        <view class="span theme-swatch">
          <view class="i" style="background:{{item.main}}"></view>
          <view class="i deep" style="background:{{item.soft}}"></view>
        </view>
        <view class="span theme-nm">
          <text>{{item.name}}</text>
          <view class="span ck">
            <view class="i-check ic"></view>
          </view>
        </view>
        <text class="span theme-desc">{{item.desc}}</text>
      </view>
    </view>

    <view class="section card preview-block">
      <text class="h2">效果预览</text>
      <view class="pv-row">
        <text class="span pv-chip">会员价 9 折</text>
        <text class="span pv-dot">金</text>
        <text class="span btn btn-sm btn-primary" style="height:68rpx">确认核销</text>
      </view>
      <view class="pv-line">
        <text class="span">累计消费</text>
        <text class="b">¥{{previewCumulative}} / ¥{{previewTarget}}</text>
      </view>
      <view class="bar-track">
        <view class="i" style="width:{{previewPercent}}%"></view>
      </view>
    </view>

    <view class="reset-row">
      <view class="button" data-theme-reset="" hover-class="tap" bindtap="resetTheme">
        <text>恢复默认（经典蓝）</text>
      </view>
    </view>
  </view>
</view>
