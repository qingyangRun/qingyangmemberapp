/* 主题颜色 */
.intro{padding:28rpx 32rpx}.intro .p{font-size:var(--fs-11);color:var(--primary);line-height:1.65}.intro .p .b{color:var(--primary);font-weight:600}.theme-list{display:grid;grid-template-columns:repeat(2,1fr);gap:20rpx;margin-top:24rpx}.theme-opt{position:relative;display:flex;flex-direction:column;gap:20rpx;padding:28rpx;border-radius:var(--r-lg);border:3rpx solid var(--line);background:var(--surface);text-align:left;color:var(--ink)}.theme-opt.on{border-color:var(--primary);box-shadow:0 0 0 6rpx var(--primary-soft)}.theme-swatch{display:flex;gap:12rpx;align-items:center}.theme-swatch .i{display:block;height:56rpx;border-radius:16rpx;flex:1}.theme-swatch .i.deep{flex:0 0 36rpx}.theme-nm{display:flex;align-items:center;justify-content:space-between;gap:12rpx;font-size:var(--fs-15);font-weight:600}.theme-nm .ck{width:40rpx;height:40rpx;margin:0}.theme-opt.on .ck{background:var(--primary);border-color:var(--primary)}.theme-opt.on .ck .ic{opacity:1}.theme-desc{font-size:var(--fs-11);color:var(--muted)}.preview-block{padding:28rpx 32rpx;margin-top:28rpx}.preview-block .h2{font-size:var(--fs-13);font-weight:600;margin-bottom:20rpx}.pv-row{display:flex;gap:16rpx;align-items:center;flex-wrap:wrap}.pv-chip{display:inline-flex;align-items:center;height:64rpx;padding:0 24rpx;border-radius:var(--r-pill);background:var(--primary-soft);color:var(--primary);font-size:var(--fs-12);font-weight:500}.pv-dot{width:52rpx;height:52rpx;border-radius:18rpx;background:var(--primary);color:#fff;display:grid;place-items:center;font-size:var(--fs-11);font-weight:600}.pv-line{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-top:24rpx;font-size:var(--fs-12);color:var(--muted)}.pv-line .b{color:var(--ink);font-variant-numeric:tabular-nums}.bar-track{height:14rpx;border-radius:8rpx;background:var(--surface-3);overflow:hidden;margin-top:16rpx}.bar-track .i{display:block;height:100%;border-radius:8rpx;background:var(--primary)}.reset-row{display:flex;justify-content:center;margin-top:36rpx}.reset-row .button{height:88rpx;padding:0 32rpx;font-size:var(--fs-13);color:var(--muted)}

.theme-opt.on{box-shadow:0 0 0 6rpx var(--primary-soft)}
