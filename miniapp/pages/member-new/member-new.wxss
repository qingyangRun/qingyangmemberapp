/* 新增会员 */
.card-opt{display:flex;align-items:center;gap:24rpx;width:100%;padding:26rpx 32rpx;border-top:2rpx solid var(--line);text-align:left}.card-opt:first-of-type{border-top:0}.card-opt .ci{flex:1;min-width:0}.card-opt .nm{display:flex;align-items:center;gap:12rpx;font-size:var(--fs-15);font-weight:500;color:var(--ink)}.card-opt .sub{margin-top:4rpx;font-size:var(--fs-12);color:var(--muted);font-variant-numeric:tabular-nums}.card-opt .pr{flex:none;text-align:right}.card-opt .pr .b{display:block;font-size:var(--fs-15);font-weight:600;font-variant-numeric:tabular-nums}.card-opt .pr .span{display:block;font-size:var(--fs-11);color:var(--muted);font-variant-numeric:tabular-nums}.card-opt.on{background:#FAFBFF}.summary .field{min-height:96rpx}.summary .lb{width:auto;font-size:var(--fs-13);color:var(--muted)}.summary .val{font-size:var(--fs-15)}.summary .total{border-top:2rpx solid var(--line)}.summary .total .lb{font-weight:600;color:var(--ink);font-size:var(--fs-15)}.summary .total .val{font-size:var(--fs-18);font-weight:600;letter-spacing:-.02em}.level-note{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:24rpx 32rpx;border-top:2rpx solid var(--line);background:var(--surface-2)}.level-note .p{font-size:var(--fs-11);color:var(--primary)}.level-note .p .b{color:var(--primary);font-weight:600}.card-opt .tag{height:40rpx;font-size:var(--fs-10)}
