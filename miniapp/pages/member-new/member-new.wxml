<view class="app theme-{{theme}} st-{{state}}">
  <view class="main mp-page has-action">
    <view class="section form-group">
      <view class="group-head">
        <text class="h2">基本信息</text>
        <text class="span">带 * 为必填</text>
      </view>
      <view class="field">
        <text class="label lb req">手机号</text>
        <view class="ctl">
          <input class="input" type="number" maxlength="11" data-key="f0" value="{{inputs.f0}}" placeholder="11 位手机号" bindinput="onInput" />
        </view>
      </view>
      <view class="field">
        <text class="label lb req">姓名</text>
        <view class="ctl">
          <input class="input" data-key="f1" value="{{inputs.f1}}" placeholder="会员姓名" bindinput="onInput" />
        </view>
      </view>
      <view class="field">
        <text class="span lb">性别</text>
        <view class="ctl">
          <view class="seg mini">
            <view class="button {{gender === 'male' ? 'on' : ''}}" hover-class="tap" bindtap="pickGender" data-gender="male">
              <text>男</text>
            </view>
            <view class="button {{gender === 'female' ? 'on' : ''}}" hover-class="tap" bindtap="pickGender" data-gender="female">
              <text>女</text>
            </view>
            <view class="button {{gender === '' ? 'on' : ''}}" hover-class="tap" bindtap="pickGender" data-gender="">
              <text>保密</text>
            </view>
          </view>
        </view>
      </view>
      <view class="button field" style="text-align:left" hover-class="tap">
        <text class="span lb">生日</text>
        <picker mode="date" value="{{birthday || '1995-01-01'}}" start="1930-01-01" end="{{today}}" bindchange="onBirthday">
          <view class="span ctl">
            <text class="span val {{birthday ? '' : 'placeholder'}}">{{birthday || '选填'}}</text>
            <view class="i-calendar ic tail"></view>
          </view>
        </picker>
      </view>
      <text class="p field-note">生日为选填项，填写后生日当月自动加入提醒，并可发送生日礼。</text>
    </view>

    <view class="section form-group">
      <view class="group-head">
        <text class="h2">初始余额</text>
        <text class="span">选填</text>
      </view>
      <view class="field">
        <text class="span lb">储值金额</text>
        <view class="ctl">
          <input class="input" type="digit" data-key="f2" value="{{inputs.f2}}" placeholder="0.00" bindinput="onInput" />
          <text class="span unit">元</text>
        </view>
      </view>
      <text class="p field-note">填写后同步生成一条「余额充值」记录；可稍后在会员详情继续充值。</text>
    </view>

    <view class="section form-group" wx:if="{{cardTypes.length}}">
      <view class="group-head">
        <text class="h2">选择次卡</text>
        <text class="span">可多选</text>
      </view>
      <view class="button card-opt {{pickedCards.indexOf(item.id) >= 0 ? 'on' : ''}}" hover-class="tap" bindtap="toggleCard" data-id="{{item.id}}" wx:for="{{cardTypes}}" wx:key="id">
        <view class="span ci">
          <view class="span nm">
            <text>{{item.name}}</text>
            <text class="span tag on" wx:if="{{item.hot}}">最受欢迎</text>
          </view>
          <text class="span sub">{{item.times}} 次 · 有效期 {{item.validDays}} 天</text>
        </view>
        <view class="span pr">
          <text class="b">¥{{item.priceText}}</text>
          <text class="span">¥{{item.unitPrice}} / 次</text>
        </view>
        <view class="span ck {{pickedCards.indexOf(item.id) >= 0 ? 'on' : ''}}">
          <view class="i-check ic"></view>
        </view>
      </view>
      <text class="p field-note">次卡金额计入累计消费，并按积分设置里的「购买次卡」比例计积分。</text>
    </view>

    <view class="section form-group summary">
      <view class="field" wx:if="{{balanceFen > 0}}">
        <text class="span lb">储值</text>
        <view class="span ctl">
          <text class="span val">¥{{balanceText}}</text>
        </view>
      </view>
      <view class="field" wx:if="{{cardTotal > 0}}">
        <text class="span lb">次卡 · 共 {{pickedCards.length}} 张</text>
        <view class="span ctl">
          <text class="span val">¥{{cardTotalText}}</text>
        </view>
      </view>
      <view class="field total">
        <text class="span lb">合计</text>
        <view class="span ctl">
          <text class="span val">¥{{grandTotalText}}</text>
        </view>
      </view>
      <view class="level-note">
        <text class="p">创建后按累计充值自动评定等级</text>
        <text class="span badge blue">{{willLevelName}}</text>
      </view>
    </view>

    <text class="p page-lead" style="margin-top:24rpx">创建后可立即为会员充值、核销，或在详情页补充标记与备注。</text>
  </view>

  <view class="mp-actionbar">
    <view class="sum">
      <text class="span">合计</text>
      <text class="b">¥{{grandTotalText}}</text>
    </view>
    <view class="a btn btn-primary" bindtap="submit" hover-class="tap">
      <text>创建会员</text>
    </view>
  </view>
</view>
