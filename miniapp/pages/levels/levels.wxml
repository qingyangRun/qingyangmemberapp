<view class="app theme-{{theme}} st-{{state}}">
  <view class="main mp-page has-action">
    <view class="section card intro">
      <view class="p">
        <text>等级按</text>
        <text class="b">累计充值</text>
        <text>或</text>
        <text class="b">累计消费</text>
        <text>自动评定，两条条件满足其一即可升级，取达标等级中的最高级；满足条件次日生效。</text>
      </view>
      <view class="intro-stats">
        <view>
          <text class="span">等级数量</text>
          <text class="b">4</text>
        </view>
        <view>
          <text class="span">金卡及以上</text>
          <view class="b">
            <text>98</text>
            <text class="small muted" style="font-size:22rpx;font-weight:400">人</text>
          </view>
        </view>
        <view>
          <text class="span">本月升级</text>
          <view class="b">
            <text>17</text>
            <text class="small muted" style="font-size:22rpx;font-weight:400">人</text>
          </view>
        </view>
      </view>
    </view>
    <view class="lv-list">
      <view class="article card lv">
        <view class="lv-top">
          <view class="span emblem black">
            <view class="i-crown ic"></view>
          </view>
          <view class="cell-main">
            <view class="lv-name">
              <text>黑金卡</text>
              <text class="span count">12 人</text>
            </view>
            <text class="lv-sub">最高等级 · 不参与降级</text>
          </view>
          <view class="a lv-edit" hover-class="tap" bindtap="setState" data-state="edit">
            <view class="i-edit ic"></view>
            <text>编辑</text>
          </view>
        </view>
        <view class="lv-cond">
          <text class="span tag">累计充值 ≥ ¥5,000</text>
          <text class="span tag">或 累计消费 ≥ ¥8,000</text>
        </view>
        <view class="lv-rights">
          <text class="span tag gold">会员价 85 折</text>
          <text class="span tag gold">积分 2 倍</text>
          <text class="span tag">生日礼</text>
        </view>
      </view>
      <view class="article card lv">
        <view class="lv-top">
          <view class="span emblem gold">
            <view class="i-crown ic"></view>
          </view>
          <view class="cell-main">
            <view class="lv-name">
              <text>金卡</text>
              <text class="span count">86 人</text>
            </view>
            <text class="lv-sub">2026 年新增 32 人</text>
          </view>
          <view class="a lv-edit" hover-class="tap" bindtap="setState" data-state="edit">
            <view class="i-edit ic"></view>
            <text>编辑</text>
          </view>
        </view>
        <view class="lv-cond">
          <text class="span tag">累计充值 ≥ ¥2,000</text>
          <text class="span tag">或 累计消费 ≥ ¥3,000</text>
        </view>
        <view class="lv-rights">
          <text class="span tag blue">会员价 9 折</text>
          <text class="span tag blue">积分 1.5 倍</text>
          <text class="span tag">生日礼</text>
        </view>
      </view>
      <view class="article card lv">
        <view class="lv-top">
          <view class="span emblem blue">
            <view class="i-crown ic"></view>
          </view>
          <view class="cell-main">
            <view class="lv-name">
              <text>银卡</text>
              <text class="span count">214 人</text>
            </view>
            <text class="lv-sub">入门付费等级</text>
          </view>
          <view class="a lv-edit" hover-class="tap" bindtap="setState" data-state="edit">
            <view class="i-edit ic"></view>
            <text>编辑</text>
          </view>
        </view>
        <view class="lv-cond">
          <text class="span tag">累计充值 ≥ ¥500</text>
          <text class="span tag">或 累计消费 ≥ ¥800</text>
        </view>
        <view class="lv-rights">
          <text class="span tag blue">会员价 95 折</text>
          <text class="span tag blue">积分 1.2 倍</text>
        </view>
      </view>
      <view class="article card lv">
        <view class="lv-top">
          <view class="span emblem">
            <view class="i-users ic"></view>
          </view>
          <view class="cell-main">
            <view class="lv-name">
              <text>普通会员</text>
              <text class="span badge gray">默认</text>
              <text class="span count">974 人</text>
            </view>
            <text class="lv-sub">新会员自动归入</text>
          </view>
          <text class="span lv-edit dis">默认等级</text>
        </view>
        <view class="lv-cond">
          <text class="span tag">无门槛</text>
        </view>
        <view class="lv-rights">
          <text class="span tag">积分 1 倍</text>
          <text class="span tag">无会员折扣</text>
        </view>
      </view>
    </view>
    <text class="p page-lead" style="margin-top:28rpx">调整等级门槛只影响之后的评定，不会改变会员已有的等级记录。</text>
  </view>
  <view class="mp-actionbar">
    <view class="sum">
      <text class="span">共 4 个等级</text>
      <text class="b">1,286 位会员</text>
    </view>
    <view class="a btn btn-primary" hover-class="tap" bindtap="setState" data-state="edit">
      <text>新建等级</text>
    </view>
  </view>
  <view class="mask">
    <view class="sheet">
      <view class="sheet-grab"></view>
      <view class="sheet-head">
        <text class="h2">等级设置</text>
        <view class="a sheet-close" hover-class="tap" bindtap="setState" data-state="default">
          <view class="i-close ic"></view>
        </view>
      </view>
      <view class="sform">
        <view class="srow">
          <text class="span lb">等级名称</text>
          <view class="ctl">
            <input class="input" data-key="f0" value="{{inputs.f0}}" placeholder="" bindinput="onInput" />
          </view>
        </view>
      </view>
      <view class="sgroup">
        <text class="h3">达成条件（满足其一即可）</text>
        <view class="sform">
          <view class="srow">
            <text class="span lb">累计充值 ≥</text>
            <view class="ctl">
              <input class="input" data-key="f1" value="{{inputs.f1}}" placeholder="" bindinput="onInput" />
              <text class="span unit">元</text>
            </view>
          </view>
          <view class="srow">
            <text class="span lb">累计消费 ≥</text>
            <view class="ctl">
              <input class="input" data-key="f2" value="{{inputs.f2}}" placeholder="" bindinput="onInput" />
              <text class="span unit">元</text>
            </view>
          </view>
        </view>
        <text class="p sheet-note">会员累计充值或累计消费任意一项达标，即自动升到该等级。</text>
      </view>
      <view class="sgroup">
        <text class="h3">会员权益</text>
        <view class="sform">
          <view class="srow">
            <text class="span lb">会员折扣</text>
            <view class="ctl">
              <input class="input" data-key="f3" value="{{inputs.f3}}" placeholder="" bindinput="onInput" />
              <text class="span unit">%（即 9 折）</text>
            </view>
          </view>
          <view class="srow">
            <text class="span lb">积分倍率</text>
            <view class="ctl">
              <input class="input" data-key="f4" value="{{inputs.f4}}" placeholder="" bindinput="onInput" />
              <text class="span unit">倍</text>
            </view>
          </view>
          <view class="srow">
            <text class="span lb">生日礼</text>
            <view class="ctl">
              <view class="button sw on" hover-class="tap"></view>
            </view>
          </view>
        </view>
      </view>
      <view class="preview">
        <view class="i-sparkles ic"></view>
        <text class="p">规则预览：会员累计充值 ¥2,400 时升为金卡；若同时达到黑金卡门槛，则直接升为黑金卡。</text>
      </view>
      <view class="a btn btn-primary btn-block" hover-class="tap" bindtap="setState" data-state="default">
        <text>保存等级</text>
      </view>
      <view class="button del-link" hover-class="tap">
        <view class="i-trash ic"></view>
        <text>删除该等级</text>
      </view>
    </view>
  </view>
</view>
