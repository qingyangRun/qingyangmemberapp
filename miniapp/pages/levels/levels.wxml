<view class="app theme-{{theme}} st-{{state}}">
  <view class="main mp-page has-action">
    <view class="section card intro">
      <view class="p">
        <text>等级按</text>
        <text class="b">累计充值</text>
        <text>或</text>
        <text class="b">累计消费</text>
        <text>自动评定，两条条件满足其一即可升级，取达标等级中的最高级。</text>
      </view>
      <view class="intro-stats">
        <view>
          <text class="span">等级数量</text>
          <text class="b">{{levels.length}}</text>
        </view>
        <view>
          <text class="span">金卡及以上</text>
          <view class="b">
            <text>{{goldPlus}}</text>
            <text class="small muted" style="font-size:22rpx;font-weight:400">人</text>
          </view>
        </view>
        <view>
          <text class="span">本月升级</text>
          <view class="b">
            <text>{{upgradedThisMonth}}</text>
            <text class="small muted" style="font-size:22rpx;font-weight:400">人</text>
          </view>
        </view>
      </view>
    </view>

    <view class="lv-list">
      <view class="article card lv" wx:for="{{levels}}" wx:key="id">
        <view class="lv-top">
          <view class="span emblem {{item.badge}}">
            <view class="i-crown ic"></view>
          </view>
          <view class="cell-main">
            <view class="lv-name">
              <text>{{item.name}}</text>
              <text class="span count">{{item.count}} 人</text>
            </view>
            <text class="lv-sub">{{item.top ? '最高等级 · 不参与降级' : (item.rechargeThreshold ? '累计充值达标升级' : '入门等级')}}</text>
          </view>
          <view class="a lv-edit" hover-class="tap" bindtap="openEdit" data-id="{{item.id}}">
            <view class="i-edit ic"></view>
            <text>编辑</text>
          </view>
        </view>
        <view class="lv-cond">
          <text class="span tag" wx:if="{{item.rechargeThreshold}}">累计充值 ≥ ¥{{item.rechargeText}}</text>
          <text class="span tag" wx:if="{{item.consumeThreshold}}">{{item.rechargeThreshold ? '或 ' : ''}}累计消费 ≥ ¥{{item.consumeText}}</text>
          <text class="span tag" wx:if="{{!item.rechargeThreshold && !item.consumeThreshold}}">无门槛</text>
        </view>
        <view class="lv-rights">
          <text class="span tag {{item.badge}}" wx:if="{{item.discount < 1}}">会员价 {{item.discountText}}</text>
          <text class="span tag {{item.badge}}">积分 {{item.pointRate}} 倍</text>
          <text class="span tag" wx:if="{{item.birthdayGift}}" bindtap="toggleGift" data-id="{{item.id}}">生日礼</text>
          <text class="span tag" wx:else bindtap="toggleGift" data-id="{{item.id}}">无生日礼</text>
        </view>
      </view>
    </view>

    <text class="p page-lead" style="margin-top:28rpx">调整等级门槛只影响之后的评定，不会改变会员已有的等级记录。</text>
  </view>

  <view class="mp-actionbar">
    <view class="sum">
      <text class="span">共 {{levels.length}} 个等级</text>
      <text class="b">{{totalMembers}} 位会员</text>
    </view>
    <view class="a btn btn-primary" hover-class="tap" bindtap="openNew">
      <text>新建等级</text>
    </view>
  </view>

  <view class="mask {{state === 'edit' ? 'show' : ''}}">
    <view class="sheet">
      <view class="sheet-grab"></view>
      <view class="sheet-head">
        <text class="h2">{{editing ? '等级设置' : '新建等级'}}</text>
        <view class="a sheet-close" hover-class="tap" bindtap="closeEdit">
          <view class="i-close ic"></view>
        </view>
      </view>

      <view class="sform">
        <view class="srow">
          <text class="span lb">等级名称</text>
          <view class="ctl">
            <input class="input" data-key="editName" value="{{editName}}" placeholder="如 金卡" bindinput="onEditInput" />
          </view>
        </view>
      </view>

      <view class="sgroup">
        <text class="h3">达成条件（满足其一即可）</text>
        <view class="sform">
          <view class="srow">
            <text class="span lb">累计充值 ≥</text>
            <view class="ctl">
              <input class="input" type="digit" data-key="editRecharge" value="{{editRecharge}}" placeholder="0" bindinput="onEditInput" />
              <text class="span unit">元</text>
            </view>
          </view>
          <view class="srow">
            <text class="span lb">累计消费 ≥</text>
            <view class="ctl">
              <input class="input" type="digit" data-key="editConsume" value="{{editConsume}}" placeholder="0" bindinput="onEditInput" />
              <text class="span unit">元</text>
            </view>
          </view>
        </view>
        <text class="p sheet-note">会员累计充值或累计消费任意一项达标，即自动升到该等级。</text>
      </view>

      <view class="sgroup">
        <text class="h3">会员权益</text>
        <view class="sform">
          <view class="srow">
            <text class="span lb">会员折扣</text>
            <view class="ctl">
              <input class="input" type="digit" data-key="editDiscount" value="{{editDiscount}}" placeholder="0.9" bindinput="onEditInput" />
              <text class="span unit">1 = 原价</text>
            </view>
          </view>
          <view class="srow">
            <text class="span lb">积分倍率</text>
            <view class="ctl">
              <input class="input" type="digit" data-key="editPointRate" value="{{editPointRate}}" placeholder="1" bindinput="onEditInput" />
              <text class="span unit">倍</text>
            </view>
          </view>
        </view>
      </view>

      <view class="preview">
        <view class="i-sparkles ic"></view>
        <text class="p">规则预览：会员累计充值 ¥{{editRecharge || 0}} 或累计消费 ¥{{editConsume || 0}} 时升为「{{editName || '该等级'}}」。</text>
      </view>

      <view class="a btn btn-primary btn-block" hover-class="tap" bindtap="saveEdit">
        <text>保存等级</text>
      </view>
    </view>
  </view>
</view>
