/* 等级管理 */
.intro{padding:28rpx 32rpx}.intro .p{font-size:var(--fs-12);color:var(--muted);line-height:1.65}.intro .p .b{color:var(--ink-2);font-weight:600}.intro-stats{display:flex;margin-top:24rpx;padding-top:24rpx;border-top:2rpx solid var(--line)}.intro-stats>div{flex:1}.intro-stats .span{display:block;font-size:var(--fs-11);color:var(--muted)}.intro-stats .b{font-size:var(--fs-18);font-weight:600;font-variant-numeric:tabular-nums}.lv-list{margin-top:24rpx}.lv{padding:28rpx 32rpx}.lv+.lv{margin-top:20rpx}.lv-top{display:flex;align-items:center;gap:24rpx}.emblem{width:88rpx;height:88rpx;border-radius:26rpx;display:grid;place-items:center;color:#fff;flex:none;background:linear-gradient(135deg,#7C8BA1,#AEBACB)}.emblem .ic{width:44rpx;height:44rpx}.emblem.black{background:linear-gradient(135deg,#1A2436,#3B4B68)}.emblem.gold{background:linear-gradient(135deg,#A9741F,#E2B563)}.emblem.blue{background:linear-gradient(135deg,#2F5DE8,#7C9BFF)}.lv-name{display:flex;align-items:center;gap:12rpx;font-size:var(--fs-16);font-weight:600;flex-wrap:wrap;row-gap:4rpx}.lv-name .count{font-size:var(--fs-11);color:var(--muted);font-weight:400;white-space:nowrap}.lv-sub{margin-top:4rpx;font-size:var(--fs-12);color:var(--muted);font-variant-numeric:tabular-nums}.lv-edit{margin-left:auto;flex:none;display:inline-flex;align-items:center;gap:4rpx;height:88rpx;padding:0 24rpx;border-radius:20rpx;background:var(--surface-2);border:2rpx solid var(--line);font-size:var(--fs-12);color:var(--ink-2)}.lv-edit .ic{width:26rpx;height:26rpx;stroke-width:2}.lv-edit.dis{color:var(--muted);background:transparent;border-color:transparent;padding:0 8rpx}.lv-cond{margin-top:20rpx;display:flex;flex-wrap:wrap;gap:12rpx}.lv-rights{margin-top:12rpx;display:flex;flex-wrap:wrap;gap:12rpx}.lv-rights .tag{height:44rpx;background:var(--surface-2)}.lv-rights .tag.gold{background:var(--gold-soft);border-color:transparent;color:var(--gold)}.lv-rights .tag.blue{background:var(--primary-soft);border-color:transparent;color:var(--primary)}.st-edit .mask{display:flex}.st-edit .mp-actionbar{display:none}
