/* 核销 */
.mode{display:flex;gap:4rpx;padding:6rpx;background:var(--surface-3);border-radius:22rpx;margin-bottom:20rpx}.mode .button{flex:1;height:88rpx;border-radius:18rpx;font-size:var(--fs-12);color:var(--muted)}.mode .button.on{background:#fff;color:var(--ink);font-weight:600;box-shadow:var(--shadow-sm)}.found{overflow:hidden}.found-top{display:flex;align-items:flex-start;gap:24rpx;padding:28rpx 32rpx 24rpx}.found-top .cell-main{min-width:0}.found .nm{display:flex;align-items:center;gap:12rpx;font-size:var(--fs-18);font-weight:600;white-space:nowrap;flex-wrap:wrap;row-gap:8rpx}.found .sub{margin-top:4rpx;font-size:var(--fs-12);color:var(--muted);font-variant-numeric:tabular-nums}.found .wrap-tags{margin-top:12rpx;gap:10rpx}.found .wrap-tags .tag{height:40rpx;font-size:var(--fs-11)}.found-assets{display:flex;border-top:2rpx solid var(--line);background:var(--surface-2)}.found-assets>view{flex:1;padding:20rpx 32rpx}.found-assets>view+view{border-left:2rpx solid var(--line)}.found-assets .span{display:block;font-size:var(--fs-11);color:var(--muted)}.found-assets .b{display:block;margin-top:2rpx;font-size:var(--fs-18);font-weight:600;font-variant-numeric:tabular-nums}.found-assets .b .small{font-size:var(--fs-11);font-weight:400;color:var(--muted);margin-left:4rpx}.svc{display:grid;grid-template-columns:repeat(3,1fr);gap:16rpx;padding-bottom:4rpx}.svc .button{width:100%;min-height:92rpx;padding:12rpx 24rpx;border-radius:22rpx;border:2rpx solid var(--line);background:var(--surface);display:flex;flex-direction:column;justify-content:center;gap:2rpx;text-align:left;color:var(--ink-2);font-size:var(--fs-13)}.svc .button .b{font-size:var(--fs-11);font-weight:500;color:var(--muted);font-variant-numeric:tabular-nums}.svc .button.on{border-color:var(--primary);background:var(--primary-soft);color:var(--primary);font-weight:600}.svc .button.on .b{color:var(--primary)}.svc .button.other{grid-column:span 2;flex-direction:row;align-items:center;justify-content:center;gap:16rpx;text-align:center}.usecard{display:flex;align-items:center;gap:24rpx;padding:20rpx 0;border-top:2rpx solid var(--line)}.usecard:first-of-type{border-top:0;padding-top:4rpx}.usecard .ci{flex:1;min-width:0}.usecard .nm{display:flex;align-items:center;gap:12rpx;font-size:var(--fs-15);font-weight:500;white-space:nowrap;flex-wrap:wrap;row-gap:6rpx}.usecard .sub{margin-top:2rpx;font-size:var(--fs-11);color:var(--muted);font-variant-numeric:tabular-nums}.sumcard{padding:28rpx 32rpx;margin-top:20rpx}.sumline{display:flex;align-items:center;justify-content:space-between;gap:16rpx;font-size:var(--fs-13);color:var(--muted);padding:6rpx 0}.sumline .b{color:var(--ink-2);font-weight:600;font-variant-numeric:tabular-nums}.sumline.total{margin-top:14rpx;padding-top:20rpx;border-top:2rpx dashed var(--line-strong);font-size:var(--fs-13);color:var(--ink)}.sumline.total .b{font-size:var(--fs-18)}.sumnote{margin-top:14rpx;font-size:var(--fs-10);color:var(--primary);line-height:1.55}.mp-actionbar .sum .b .i{font-style:normal;font-size:var(--fs-11);font-weight:400;color:var(--muted)}.mp-actionbar .sum .b .i{display:none}.search-only{display:block}.st-search .found-wrap{display:none}.st-search .search-only{display:block}.st-search .mp-actionbar{display:none}.howto .cell{padding:24rpx 32rpx}.howto .cell-title{font-size:var(--fs-13);font-weight:500}.howto .cell-sub{margin-top:2rpx}.recent-sum{display:flex;align-items:center;gap:32rpx;padding:4rpx 8rpx 20rpx}.recent-sum .b{font-size:var(--fs-18);font-weight:600;font-variant-numeric:tabular-nums}.recent-sum .span{font-size:var(--fs-12);color:var(--muted)}
