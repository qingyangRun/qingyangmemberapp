/* 积分设置 */
.master{display:flex;align-items:center;gap:24rpx;padding:32rpx}.master .mi{width:92rpx;height:92rpx;border-radius:28rpx;display:grid;place-items:center;background:var(--gold-soft);color:var(--gold);flex:none}.master .mi .ic{width:46rpx;height:46rpx}.master .nm{display:flex;align-items:center;gap:14rpx;font-size:var(--fs-16);font-weight:600}.master .sub{margin-top:4rpx;font-size:var(--fs-12);color:var(--muted);line-height:1.5}.rule{padding:28rpx 32rpx}.rule+.rule{margin-top:20rpx}.rule-top{display:flex;align-items:center;gap:24rpx}.rule-top .nm{font-size:var(--fs-15);font-weight:600}.rule-top .sub{margin-top:4rpx;font-size:var(--fs-11);color:var(--muted)}.ratio{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-top:24rpx;padding-top:24rpx;border-top:2rpx dashed var(--line-strong)}.ratio .rt{font-size:var(--fs-12);color:var(--muted)}.ratio .rbox{display:flex;align-items:center;gap:12rpx;height:88rpx;padding:0 20rpx;border-radius:18rpx;border:2rpx solid var(--line-strong);background:#fff}.ratio .rbox .input{width:92rpx;min-height:88rpx;border:0;background:none;outline:none;text-align:center;font-size:var(--fs-15);font-weight:600;font-variant-numeric:tabular-nums}.ratio .rbox .u{font-size:var(--fs-12);color:var(--muted)}.off-rule{opacity:.55}.off-rule .ratio .rbox{background:var(--surface-2)}.preview-card{padding:28rpx 32rpx;margin-top:32rpx}.preview-head{display:flex;align-items:center;gap:12rpx;font-size:var(--fs-13);font-weight:600}.preview-head .ic{width:30rpx;height:30rpx;color:var(--gold)}.pline{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:12rpx 0;font-size:var(--fs-13);color:var(--muted)}.pline .b{color:var(--ink-2);font-weight:600;font-variant-numeric:tabular-nums}.pline .pts{color:var(--gold);font-weight:600;font-variant-numeric:tabular-nums}.preview-note{margin-top:16rpx;padding-top:20rpx;border-top:2rpx solid var(--line);font-size:var(--fs-10);color:var(--primary);line-height:1.6}
