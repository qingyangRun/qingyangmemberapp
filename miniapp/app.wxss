/* ---------- 通用补充（数据层用到的状态类） ---------- */
.btn.disabled{opacity:.45;pointer-events:none}
.search-clear{width:44rpx;height:44rpx;color:var(--faint);flex:none}
.placeholder{color:var(--faint)}
.card.empty{background:var(--surface);border:2rpx solid var(--line);border-radius:var(--r-lg);text-align:center;padding:64rpx 40rpx;color:var(--muted);font-size:var(--fs-13);line-height:1.6}