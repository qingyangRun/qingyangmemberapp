/* 小程序外壳 */
.app{min-height:100vh;background:var(--bg)}
view,text,image,input,textarea,scroll-view,button{box-sizing:border-box}
.tap{opacity:.72}
.mp-actionbar{padding-bottom:calc(88rpx + env(safe-area-inset-bottom))}
.grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:16rpx}


