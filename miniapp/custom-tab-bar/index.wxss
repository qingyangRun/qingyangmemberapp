/* ---------- 主题色 ----------
 * 组件样式隔离，page 上的 --primary 拿不到，这里按主题各声明一份。
 * 与 app.wxss 的 .theme-* 保持一致（只取标签栏用到的 --primary）。
 */
.tb.theme-green{--primary:#0F7A5A}
.tb.theme-violet{--primary:#5B3FD1}
.tb.theme-orange{--primary:#BF5A14}
.tb.theme-rose{--primary:#BF3566}
.tb.theme-graphite{--primary:#2B3A52}