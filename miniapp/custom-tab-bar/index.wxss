/* 底部标签栏（自定义组件）
 *
 * 注意：custom-tab-bar 是自定义组件，默认 styleIsolation: isolated，
 * app.wxss 里的 .ic / .i-* 规则不会进入组件内部——图标会显示成空白。
 * 所以这里把用到的 5 个图标样式复制了一份，图标定义仍以 app.wxss 为准，
 * 增删 tab 时两边要一起改。
 */

.tb{position:fixed;left:0;right:0;bottom:0;z-index:30;display:flex;height:calc(100rpx + env(safe-area-inset-bottom));padding-bottom:env(safe-area-inset-bottom);background:#fff;box-shadow:0 -2rpx 0 #E4E9F1}

.tb-item{
  flex:1;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  gap:6rpx;
  color:#5A6A82;
  font-size:20rpx;
  font-weight:500;
  /* 点击区至少 88rpx 高，符合移动端最小点击尺寸 */
  min-height:88rpx;
}

.tb-item.on{color:var(--primary,#2457F5);font-weight:600}

/* 图标基类：用 SVG data-URI 做 mask，颜色跟随 currentColor */
.ic{
  width:48rpx;
  height:48rpx;
  flex:none;
  display:block;
  background-color:currentColor;
  -webkit-mask-repeat:no-repeat;
  mask-repeat:no-repeat;
  -webkit-mask-position:center;
  mask-position:center;
  -webkit-mask-size:contain;
  mask-size:contain;
}

.tb-ic{width:46rpx;height:46rpx}

